{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo pkgid:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo run -p doge-shell -- --help)",
      "Bash(rustfmt:*)",
      "Bash(./target/release/dogesh -c:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(cd:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check-ai-guidance.sh)",
      "Bash(scripts/check-shell-proxy-capabilities.py)",
      "Bash(scripts/check-portability.py)",
      "Bash(scripts/check-execution-authority.py:*)",
      "Bash(scripts/check-file-budget.py)",
      "Bash(scripts/check-file-budget.py --list)",
      "Bash(scripts/check-file-budget.py --update)",
      "Bash(scripts/claude-post-edit.sh)",
      "Bash(scripts/install-runtime-skills.sh --list:*)",
      "Bash(scripts/install-runtime-skills.sh --status:*)",
      "Bash(scripts/install-runtime-skills.sh --dry-run:*)"
    ]
  },
  "skillOverrides": {
    "doge-shell-builtin-commands": "name-only",
    "doge-shell-chat-tools": "name-only",
    "doge-shell-command-palette-ai": "name-only",
    "doge-shell-completion-spec": "name-only",
    "doge-shell-env-startup": "name-only",
    "doge-shell-history-frecency": "name-only",
    "doge-shell-lisp-config": "name-only",
    "doge-shell-notebook-markdown": "name-only",
    "doge-shell-parser-shell": "name-only",
    "doge-shell-process-pty": "name-only",
    "doge-shell-prompt-terminal-ui": "name-only",
    "doge-shell-repl-completion": "name-only",
    "doge-shell-safety-policy": "name-only",
    "doge-shell-serve-web": "name-only",
    "doge-shell-execution-semantics": "name-only",
    "dsh-skill-authoring": "name-only",
    "dsh-chat": "user-invocable-only",
    "dsh-cron": "user-invocable-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/claude-post-edit.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
