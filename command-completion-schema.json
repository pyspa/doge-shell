                    "nomad.allocation",
                    "nomad.job",
                    "nomad.namespace",
                    "nomad.node",
                    "nomad.volume",
                    "nox.session",
                    "ollama.model",
                    "pacman.package",
                    "pacman.repository",
                    "pdm.script",
                    "pip.installed_package",
                    "pipenv.script",
                    "pipx.installed_package",
                    "podman.container",
                    "podman.image",
                    "podman.network",
                    "podman.volume",
                    "pre_commit.hook_id",
                    "project.task",
                    "python.module",
                    "python.project_dependency",
                    "rclone.remote",
                    "restic.snapshot",
                    "rg.file_type",
                    "rpm.installed_package",
                    "rustup.component",
                    "rustup.target",
                    "rustup.toolchain",
                    "screen.session",
                    "selinux.boolean",
                    "selinux.module",
                    "shell.abbr",
                    "shell.alias",
                    "shell.env_var",
                    "shell.job",
                    "snap.package",
                    "snapper.config",
                    "snapper.snapshot",
                    "ssh.host",
                    "swap.device",
                    "sysctl.key",
                    "system.owner_group",
                    "system.process_name",
                    "system.process_pid",
                    "systemctl.unit",
                    "systemctl.unit_file",
                    "terraform.resource",
                    "terraform.workspace",
                    "timedatectl.timezone",
                    "tmux.session",
                    "tox.environment",
                    "udev.subsystem",
                    "ufw.application",
                    "vault.auth_method",
                    "vault.policy",
                    "vault.secrets_engine",
                    "wireguard.config",
                    "wireguard.interface",
                    "wireless.device",
                    "zfs.dataset",
                    "zpool.pool",
                    "zypper.installed_package"
                  ]
                },
                "scope": {
                  "type": ["string", "null"],
                  "description": "Optional scope hint for the provider"
                }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "title": "Script Type",
          "description": "Runtime-only manual completion type. comp-gen generated definitions must not emit Script.",
          "required": ["type", "data"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["Script"]
            },
            "data": {
              "type": "string",
              "description": "Shell command to execute for generating completions"
            }
          }
        }
      ]
    }
  }
}
