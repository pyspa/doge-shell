                    "js.dependency",
                    "k3d.cluster",
                    "kernel.module",
                    "kind.cluster",
                    "kubectl.context",
                    "kubectl.namespace",
                    "kubectl.resource_name",
                    "kubectl.resource_type",
                    "localectl.keymap",
                    "localectl.locale",
                    "login.shell",
                    "loginctl.seat",
                    "loginctl.session",
                    "loop.device",
                    "lvm.logical_volume",
                    "lvm.physical_volume",
                    "lvm.volume_group",
                    "machinectl.machine",
                    "man.page",
                    "maven.module",
