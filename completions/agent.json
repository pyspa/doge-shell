{
  "command": "agent",
  "description": "Run and resume persistent AI tasks",
  "subcommands": [
    {
      "name": "run",
      "description": "Start a task",
      "options": [
        {
          "long": "--timeout",
          "description": "Cumulative time budget in seconds (default: 1800)",
          "takes_value": true
        },
        {
          "long": "--read",
          "description": "Readable directory",
          "takes_value": true
        },
        {
          "long": "--write",
          "description": "Writable directory",
          "takes_value": true
        },
        {
          "long": "--allow-command",
          "description": "Exact allowed command",
          "takes_value": true
        },
        {
          "long": "--profile",
          "description": "Named bundle of exact allowed commands",
          "takes_value": true
        },
        {
          "long": "--allow-mcp",
          "description": "Exact MCP approval key",
          "takes_value": true
        },
        {
          "long": "--network",
          "description": "Allowed sandbox host",
          "takes_value": true
        },
        {
          "long": "--env",
          "description": "Inherited environment variable",
          "takes_value": true
        },
        {
          "long": "--sandbox",
          "description": "Require pinned SRT isolation"
        },
        {
          "long": "--check",
          "description": "Completion criterion",
          "takes_value": true
        },
        {
          "long": "--detach",
          "short": "-d",
          "description": "Run in a separate process and return immediately"
        },
        {
          "long": "--dry-run",
          "description": "Show the expanded grant without starting"
        }
      ]
    },
    {
      "name": "resume",
      "description": "Resume a saved task",
      "options": [
        {
          "long": "--timeout",
          "description": "Cumulative time budget in seconds",
          "takes_value": true
        },
        {
          "long": "--read",
          "description": "Readable directory",
          "takes_value": true
        },
        {
          "long": "--write",
          "description": "Writable directory",
          "takes_value": true
        },
        {
          "long": "--allow-command",
          "description": "Exact allowed command",
          "takes_value": true
        },
        {
          "long": "--profile",
          "description": "Named bundle of exact allowed commands",
          "takes_value": true
        },
        {
          "long": "--allow-mcp",
          "description": "Exact MCP approval key",
          "takes_value": true
        },
        {
          "long": "--network",
          "description": "Allowed sandbox host",
          "takes_value": true
        },
        {
          "long": "--env",
          "description": "Inherited environment variable",
          "takes_value": true
        },
        {
          "long": "--reconcile",
          "description": "Observed result of interrupted operation",
          "takes_value": true
        },
        {
          "long": "--detach",
          "short": "-d",
          "description": "Run in a separate process and return immediately"
        },
        {
          "long": "--dry-run",
          "description": "Show the expanded grant without starting"
        }
      ],
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "retry",
      "description": "Clone a task with new grants and run it again",
      "options": [
        {
          "long": "--timeout",
          "description": "Cumulative time budget in seconds",
          "takes_value": true
        },
        {
          "long": "--read",
          "description": "Readable directory",
          "takes_value": true
        },
        {
          "long": "--write",
          "description": "Writable directory",
          "takes_value": true
        },
        {
          "long": "--allow-command",
          "description": "Exact allowed command",
          "takes_value": true
        },
        {
          "long": "--profile",
          "description": "Named bundle of exact allowed commands",
          "takes_value": true
        },
        {
          "long": "--allow-mcp",
          "description": "Exact MCP approval key",
          "takes_value": true
        },
        {
          "long": "--network",
          "description": "Allowed sandbox host",
          "takes_value": true
        },
        {
          "long": "--env",
          "description": "Inherited environment variable",
          "takes_value": true
        },
        {
          "long": "--reconcile",
          "description": "Observed result of interrupted operation",
          "takes_value": true
        },
        {
          "long": "--check",
          "description": "Additional completion criterion",
          "takes_value": true
        },
        {
          "long": "--detach",
          "short": "-d",
          "description": "Run in a separate process and return immediately"
        },
        {
          "long": "--dry-run",
          "description": "Show the expanded grant without starting"
        }
      ],
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "profiles",
      "description": "List named command bundles"
    },
    {
      "name": "list",
      "description": "List tasks",
      "options": [
        {
          "long": "--all",
          "description": "Include tasks finished over a day ago"
        },
        {
          "long": "--json",
          "description": "Machine-readable output"
        }
      ]
    },
    {
      "name": "logs",
      "description": "Show recorded events",
      "options": [
        {
          "long": "--follow",
          "description": "Follow events until the task stops"
        },
        {
          "long": "--json",
          "description": "Machine-readable output"
        },
        {
          "long": "--since",
          "description": "Only events past this sequence number",
          "takes_value": true
        }
      ],
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "wait",
      "description": "Wait until a task stops, then show the summary",
      "options": [
        {
          "long": "--timeout",
          "description": "Give up waiting after N seconds",
          "takes_value": true
        }
      ],
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "show",
      "description": "Show task and events",
      "options": [
        {
          "long": "--summary",
          "description": "Short report instead of the full record"
        }
      ],
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "cancel",
      "description": "Request cancellation",
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete task records",
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Diagnose stuck tasks and stale state",
      "options": [
        {
          "long": "--json",
          "description": "Machine-readable output"
        }
      ]
    },
    {
      "name": "respond",
      "description": "Provide remote task input",
      "arguments": [
        {
          "name": "id",
          "description": "Task ID",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "agent.task"
            }
          }
        }
      ]
    }
  ]
}
