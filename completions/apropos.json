{
  "command": "apropos",
  "description": "Search the manual page names and descriptions",
  "global_options": [
    {
      "short": "-s",
      "long": "--sections",
      "description": "Search only the given manual sections",
      "takes_value": true
    },
    {
      "short": "-a",
      "long": "--and",
      "description": "Require all keywords to match"
    },
    {
      "short": "-e",
      "long": "--exact",
      "description": "Match keywords exactly"
    },
    {
      "short": "-r",
      "long": "--regex",
      "description": "Interpret each keyword as a regular expression"
    },
    {
      "short": "-w",
      "long": "--wildcard",
      "description": "Interpret each keyword as a shell wildcard pattern"
    },
    {
      "short": "-l",
      "long": "--long",
      "description": "Do not trim output to the terminal width"
    },
    {
      "short": "-M",
      "long": "--manpath",
      "description": "Manual page search path",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-L",
      "long": "--locale",
      "description": "Locale to use",
      "takes_value": true
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "keyword",
      "description": "Keyword or manual page name",
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "man.page"
        }
      }
    }
  ]
}
