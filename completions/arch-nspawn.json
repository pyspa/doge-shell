{
  "command": "arch-nspawn",
  "description": "Run a command or OS in an Arch namespace container",
  "global_options": [
    {
      "short": "-C",
      "description": "Pacman configuration",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "conf"
          ]
        }
      }
    },
    {
      "short": "-M",
      "description": "Makepkg configuration",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "conf"
          ]
        }
      }
    },
    {
      "short": "-c",
      "description": "Package cache directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-f",
      "description": "Copy a host file as source[:destination]",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-s",
      "description": "Do not run setarch"
    },
    {
      "short": "-h",
      "description": "Show help"
    }
  ],
  "arguments": [
    {
      "name": "working-dir",
      "type": {
        "type": "Directory"
      }
    },
    {
      "name": "systemd-nspawn-argument",
      "required": false,
      "multiple": true,
      "type": {
        "type": "CommandWithArgs"
      }
    }
  ]
}
