{
  "command": "borg",
  "description": "Deduplicating backup tool",
  "global_options": [
    { "long": "--log-level", "description": "Log level", "takes_value": true, "value_type": { "type": "Choice", "data": ["debug", "info", "warning", "error", "critical"] } },
    { "long": "--lock-wait", "description": "Lock wait seconds", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "init", "description": "Initialize repository" },
    { "name": "create", "description": "Create archive", "arguments": [{ "name": "archive", "description": "Archive name" }, { "name": "path", "multiple": true, "type": { "type": "File", "data": {} } }] },
    { "name": "list", "description": "List repository or archive" },
    { "name": "extract", "description": "Extract archive" },
    { "name": "mount", "description": "Mount archive", "arguments": [{ "name": "archive" }, { "name": "mountpoint", "type": { "type": "Directory" } }] },
    { "name": "prune", "description": "Prune archives" },
    { "name": "compact", "description": "Compact repository" },
    { "name": "check", "description": "Check repository" }
  ]
}
