{
  "command": "cargo",
  "description": "Rust package manager",
  "global_options": [
    {
      "long": "--version",
      "short": "-V",
      "description": "Print version info and exit"
    },
    {
      "long": "--help",
      "short": "-h",
      "description": "Print help information"
    },
    {
      "long": "--verbose",
      "short": "-v",
      "description": "Use verbose output"
    },
    {
      "long": "--quiet",
      "short": "-q",
      "description": "No output printed to stdout"
    }
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Compile the current package",
      "options": [
        {
          "long": "--release",
          "description": "Build artifacts in release mode, with optimizations"
        },
        {
          "long": "--target",
          "description": "Build for the target triple"
        },
        {
          "long": "--features",
          "description": "Space or comma separated list of features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to build",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Build all packages in the workspace"
        },
        {
          "long": "--all-targets",
          "description": "Build all targets"
        },
        {
          "long": "--jobs",
          "short": "-j",
          "description": "Number of parallel jobs, defaults to # of CPUs"
        },
        {
          "long": "--target-dir",
          "description": "Directory for all generated artifacts"
        }
      ],
      "arguments": [],
      "subcommands": []
    },
    {
      "name": "run",
      "description": "Run a binary or example of the local package",
      "options": [
        {
          "long": "--release",
          "description": "Build artifacts in release mode, with optimizations"
        },
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--bin",
          "description": "Name of the bin target to run",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.bin" }
          }
        },
        {
          "long": "--example",
          "description": "Name of the example target to run",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.example" }
          }
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to run",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--jobs",
          "short": "-j",
          "description": "Number of parallel jobs, defaults to # of CPUs"
        }
      ],
      "arguments": [
        {
          "name": "args",
          "description": "Arguments to pass to the program"
        }
      ],
      "subcommands": []
    },
    {
      "name": "test",
      "description": "Run the tests",
      "options": [
        {
          "long": "--release",
          "description": "Build artifacts in release mode, with optimizations"
        },
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--lib",
          "description": "Test only this package's library unit tests"
        },
        {
          "long": "--doc",
          "description": "Test only this library's documentation"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to test",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Test all packages in the workspace"
        },
        {
          "long": "--all-targets",
          "description": "Test all targets"
        },
        {
          "long": "--jobs",
          "short": "-j",
          "description": "Number of parallel jobs, defaults to # of CPUs"
        },
        {
          "long": "--nocapture",
          "description": "Show output from tests"
        },
        {
          "long": "--test",
          "description": "Test only the specified integration test target",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.test" } }
        },
        {
          "long": "--bin",
          "description": "Test only the specified binary",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.bin" } }
        },
        {
          "long": "--example",
          "description": "Test only the specified example",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.example" } }
        },
        {
          "long": "--bench",
          "description": "Test only the specified bench target",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.bench" } }
        },
        {
          "long": "--no-run",
          "description": "Compile, but don't run tests"
        }
      ],
      "arguments": [
        {
          "name": "testname",
          "description": "Test name filter"
        }
      ],
      "subcommands": []
    },
    {
      "name": "new",
      "description": "Create a new cargo package",
      "options": [
        {
          "long": "--bin",
          "description": "Use a binary (application) template"
        },
        {
          "long": "--lib",
          "description": "Use a library template"
        },
        {
          "long": "--name",
          "description": "Set the resulting package name"
        },
        {
          "long": "--vcs",
          "description": "Initialize a new repository for the given version control system (git, hg, pijul, or fossil) or do not initialize any version control at all (none)"
        }
      ],
      "arguments": [
        {
          "name": "path",
          "description": "Directory path for the new package"
        }
      ],
      "subcommands": []
    },
    {
      "name": "add",
      "description": "Add dependencies to a Cargo.toml manifest file",
      "options": [
        {
          "long": "--dev",
          "description": "Add as development dependency"
        },
        {
          "long": "--build",
          "description": "Add as build dependency"
        },
        {
          "long": "--features",
          "description": "Space or comma separated list of features to activate"
        },
        {
          "long": "--path",
          "description": "Filesystem path to local crate to add"
        },
        {
          "long": "--git",
          "description": "Git URL to add the specified crate from"
        },
        {
          "long": "--branch",
          "description": "Branch to use when adding from git"
        },
        {
          "long": "--tag",
          "description": "Tag to use when adding from git"
        },
        {
          "long": "--rev",
          "description": "Specific commit to use when adding from git"
        },
        {
          "long": "--optional",
          "description": "Add as an optional dependency"
        },
        {
          "long": "--no-default-features",
          "description": "Disable the default features of the dependency"
        },
        {
          "long": "--rename",
          "description": "Rename the dependency"
        }
      ],
      "arguments": [
        {
          "name": "crate",
          "description": "Crate name to add"
        }
      ],
      "subcommands": []
    },
    {
      "name": "install",
      "description": "Install a Rust binary",
      "options": [
        {
          "long": "--git",
          "description": "Git URL to install the specified crate from"
        },
        {
          "long": "--path",
          "description": "Filesystem path to local crate to install"
        },
        {
          "long": "--force",
          "short": "-f",
          "description": "Force overwriting existing crates or binaries"
        },
        {
          "long": "--list",
          "description": "List all installed packages and their versions"
        }
      ],
      "arguments": [
        {
          "name": "crate",
          "description": "Crate name to install"
        }
      ],
      "subcommands": []
    },
    {
      "name": "uninstall",
      "description": "Remove a Rust binary installed with cargo install",
      "options": [
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to uninstall",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.installed_binary" } }
        },
        {
          "long": "--bin",
          "description": "Only uninstall the binary NAME",
          "takes_value": true
        },
        {
          "long": "--root",
          "description": "Directory to uninstall packages from",
          "takes_value": true,
          "value_type": { "type": "Directory" }
        }
      ],
      "arguments": [
        {
          "name": "crate",
          "description": "Installed crate to remove",
          "multiple": true,
          "type": { "type": "Dynamic", "data": { "provider": "cargo.installed_binary" } }
        }
      ],
      "subcommands": []
    },
    {
      "name": "check",
      "description": "Check a local package and all of its dependencies for errors",
      "options": [
        {
          "long": "--release",
          "description": "Check artifacts in release mode, with optimizations"
        },
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to check",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--all-targets",
          "description": "Check all targets"
        },
        {
          "long": "--workspace",
          "description": "Check all packages in the workspace"
        }
      ],
      "subcommands": []
    },
    {
      "name": "clippy",
      "description": "Run Clippy lints",
      "options": [
        {
          "long": "--fix",
          "description": "Automatically apply lint suggestions"
        },
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--allow-dirty",
          "description": "Fix code even if the working directory has changes"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to lint",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Lint all packages in the workspace"
        },
        {
          "long": "--all-targets",
          "description": "Lint all targets"
        }
      ],
      "subcommands": []
    },
    {
      "name": "fmt",
      "description": "Format Rust code",
      "options": [
        {
          "long": "--check",
          "description": "Run in check mode (don't modify files)"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to format",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--all",
          "description": "Format all packages in the workspace"
        }
      ],
      "subcommands": []
    },
    {
      "name": "bench",
      "description": "Run benchmarks",
      "options": [
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to benchmark",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Benchmark all packages in workspace"
        },
        {
          "long": "--bench",
          "description": "Benchmark only the specified bench target",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.bench" } }
        },
        {
          "long": "--test",
          "description": "Benchmark only the specified test target",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.test" } }
        }
      ],
      "arguments": [
        {
          "name": "benchname",
          "description": "Benchmark name filter"
        }
      ],
      "subcommands": []
    },
    {
      "name": "doc",
      "description": "Build a package's documentation",
      "options": [
        {
          "long": "--features",
          "description": "Features to activate",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } }
        },
        {
          "long": "--open",
          "description": "Open docs in a browser after building them"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to document",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Document all packages in workspace"
        },
        {
          "long": "--no-deps",
          "description": "Do not build documentation for dependencies"
        }
      ],
      "subcommands": []
    },
    {
      "name": "clean",
      "description": "Remove generated artifacts",
      "options": [
        {
          "long": "--release",
          "description": "Clean release artifacts"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to clean",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--target-dir",
          "description": "Directory for all generated artifacts"
        }
      ],
      "subcommands": []
    },
    {
      "name": "update",
      "description": "Update dependencies in Cargo.lock",
      "options": [
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to update",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--workspace",
          "description": "Update all packages in workspace"
        },
        {
          "long": "--dry-run",
          "description": "Don't actually write changes"
        }
      ],
      "subcommands": []
    },
    {
      "name": "publish",
      "description": "Upload a package to crates.io",
      "options": [
        {
          "long": "--dry-run",
          "description": "Perform checks without publishing"
        },
        {
          "long": "--package",
          "short": "-p",
          "description": "Package to publish",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": { "provider": "cargo.package" }
          }
        },
        {
          "long": "--allow-dirty",
          "description": "Allow dirty working directories to be packaged"
        }
      ],
      "subcommands": []
    },
    {
      "name": "nextest",
      "description": "Run tests with cargo-nextest",
      "subcommands": [
        {
          "name": "run",
          "description": "Run tests",
          "options": [
            { "short": "-p", "long": "--package", "description": "Package", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "cargo.package" } } },
            { "long": "--test", "description": "Test target", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "cargo.test" } } },
            { "long": "--features", "description": "Cargo features", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "cargo.feature" } } }
          ],
          "arguments": [{ "name": "filter-expression", "required": false, "multiple": true, "type": { "type": "String" } }]
        },
        { "name": "list", "description": "List tests" },
        { "name": "archive", "description": "Archive tests" },
        { "name": "show-config", "description": "Show resolved configuration" }
      ]
    },
    {
      "name": "watch",
      "description": "Watch files and run Cargo commands",
      "options": [
        { "short": "-w", "long": "--watch", "description": "Path to watch", "takes_value": true, "value_type": { "type": "Directory" } },
        { "short": "-x", "long": "--exec", "description": "Cargo command to execute", "takes_value": true, "value_type": { "type": "String" } },
        { "short": "-s", "long": "--shell", "description": "Shell command to execute", "takes_value": true, "value_type": { "type": "CommandWithArgs" } },
        { "short": "-c", "long": "--clear", "description": "Clear screen before each run" }
      ]
    },
    {
      "name": "init",
      "description": "Create a new cargo package in an existing directory",
      "options": [
        { "long": "--bin", "description": "Use a binary (application) template" },
        { "long": "--lib", "description": "Use a library template" },
        { "long": "--name", "description": "Set the resulting package name", "takes_value": true, "value_type": { "type": "String" } },
        { "long": "--vcs", "description": "Specify the VCS to use", "takes_value": true, "value_type": { "type": "Choice", "data": ["git", "hg", "pijul", "fossil", "none"] } }
      ]
    },
    {
      "name": "fetch",
      "description": "Fetch dependencies of a package from the network",
      "options": [
        { "long": "--locked", "description": "Require Cargo.lock to be up to date" }
      ]
    },
    {
      "name": "fix",
      "description": "Automatically fix lint warnings reported by rustc",
      "options": [
        { "long": "--allow-dirty", "description": "Fix code even if the working directory is dirty" },
        { "long": "--allow-no-vcs", "description": "Fix code even if a VCS is not detected" },
        { "long": "--broken-code", "description": "Fix code even if it already has compiler errors" },
        { "long": "--edition", "description": "Fix in preparation for the given edition", "takes_value": true, "value_type": { "type": "String" } }
      ]
    },
    {
      "name": "info",
      "description": "Display information about a package",
      "arguments": [
        {
          "name": "crate",
          "description": "Crate to inspect"
        }
      ]
    },
    {
      "name": "login",
      "description": "Log in to a registry",
      "options": [
        { "long": "--registry", "description": "Registry to use", "takes_value": true, "value_type": { "type": "String" } }
      ],
      "arguments": [
        { "name": "token", "description": "API token", "required": false }
      ]
    },
    {
      "name": "logout",
      "description": "Remove an API token from the registry locally",
      "options": [
        { "long": "--registry", "description": "Registry to use", "takes_value": true, "value_type": { "type": "String" } }
      ]
    },
    {
      "name": "search",
      "description": "Search packages in the registry",
      "options": [
        { "long": "--limit", "description": "Number of results to show", "takes_value": true, "value_type": { "type": "Number" } }
      ],
      "arguments": [
        { "name": "query", "description": "Search query" }
      ]
    },
    {
      "name": "tree",
      "description": "Display a tree visualization of a dependency graph",
      "options": [
        { "long": "--invert", "short": "-i", "description": "Show the reverse dependencies", "takes_value": true, "value_type": { "type": "String" } },
        { "long": "--duplicates", "short": "-d", "description": "Show multiple versions of the same package" },
        { "long": "--charset", "description": "Character set to use", "takes_value": true, "value_type": { "type": "Choice", "data": ["utf8", "ascii"] } }
      ]
    },
    {
      "name": "yank",
      "description": "Remove a pushed crate from the index",
      "arguments": [
        { "name": "crate", "description": "Crate to yank" },
        { "name": "version", "description": "Version to yank" }
      ]
    },
    {
      "name": "owner",
      "description": "Manage the owners of a crate on the registry",
      "subcommands": [
        { "name": "add", "description": "Add an owner to a crate" },
        { "name": "remove", "description": "Remove an owner from a crate" },
        { "name": "list", "description": "List the owners of a crate" }
      ]
    },
    {
      "name": "package",
      "description": "Assemble the local package into a distributable tarball",
      "options": [
        { "long": "--list", "description": "Print files included in a package without making one" },
        { "long": "--allow-dirty", "description": "Allow dirty working directories to be packaged" },
        { "long": "--no-verify", "description": "Don't verify the contents by building them" }
      ]
    },
    {
      "name": "rustc",
      "description": "Compile a package, and pass extra options to the compiler",
      "options": [
        { "long": "--release", "description": "Build artifacts in release mode" },
        { "long": "--profile", "description": "Build with the specified profile", "takes_value": true, "value_type": { "type": "String" } },
        { "long": "--package", "short": "-p", "description": "Package to build", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "cargo.package" } } }
      ]
    },
    {
      "name": "locate-project",
      "description": "Print a JSON representation of a Cargo.toml file's location",
      "options": [
        { "long": "--workspace", "description": "Locate the workspace root" },
        { "long": "--message-format", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["json", "plain"] } }
      ]
    },
    {
      "name": "metadata",
      "description": "Output the resolved dependencies of a package in machine-readable format",
      "options": [
        { "long": "--format-version", "description": "Format version", "takes_value": true, "value_type": { "type": "Number" } },
        { "long": "--no-deps", "description": "Output information only about the workspace members" }
      ]
    },
    {
      "name": "generate-lockfile",
      "description": "Generate the lockfile for a package"
    },
    {
      "name": "vendor",
      "description": "Vendor all dependencies for a project locally",
      "options": [
        { "long": "--sync", "description": "Sync with a lockfile", "takes_value": true, "value_type": { "type": "File", "data": {} } },
        { "long": "--no-delete", "description": "Don't delete older crates in the vendor directory" }
      ]
    },
    {
      "name": "report",
      "description": "Generate and display various kinds of reports",
      "subcommands": [
        { "name": "future-incompat", "description": "Display a future-incompat report" }
      ]
    },
    {
      "name": "config",
      "description": "Inspect configuration values",
      "subcommands": [
        { "name": "get", "description": "Get a configuration value" },
        { "name": "set", "description": "Set a configuration value" },
        { "name": "unset", "description": "Unset a configuration value" }
      ]
    }
  ]
}
