{
  "command": "chezmoi",
  "description": "Manage dotfiles across multiple machines",
  "global_options": [
    { "short": "-D", "long": "--destination", "description": "Destination directory", "takes_value": true, "value_type": { "type": "Directory" } },
    { "short": "-S", "long": "--source", "description": "Source directory", "takes_value": true, "value_type": { "type": "Directory" } },
    { "short": "-n", "long": "--dry-run", "description": "Show changes without applying them" },
    { "short": "-v", "long": "--verbose", "description": "Enable verbose output" }
  ],
  "subcommands": [
    { "name": "init", "description": "Initialize chezmoi", "arguments": [{ "name": "repo", "description": "Repository or source directory", "required": false }] },
    { "name": "add", "description": "Add targets to the source state", "arguments": [{ "name": "target", "description": "Target path", "multiple": true, "type": { "type": "File", "data": {} } }] },
    { "name": "apply", "description": "Update targets", "arguments": [{ "name": "target", "description": "Target path", "required": false, "multiple": true, "type": { "type": "File", "data": {} } }] },
    { "name": "update", "description": "Pull and apply source changes" },
    { "name": "diff", "description": "Show pending changes" },
    { "name": "edit", "description": "Edit a target's source", "arguments": [{ "name": "target", "description": "Target path", "type": { "type": "File", "data": {} } }] },
    { "name": "cd", "description": "Open a shell in the source directory" },
    { "name": "data", "description": "Print template data" },
    { "name": "doctor", "description": "Check for configuration problems" },
    { "name": "managed", "description": "List managed entries" },
    { "name": "source-path", "description": "Print a target's source path" },
    { "name": "target-path", "description": "Print a source's target path" },
    { "name": "verify", "description": "Exit unsuccessfully if targets are out of date" },
    { "name": "execute-template", "description": "Execute templates" }
  ]
}
