{
  "command": "chsh",
  "description": "Change the login shell",
  "global_options": [
    {
      "short": "-s",
      "long": "--shell",
      "description": "New login shell",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "login.shell" } }
    },
    { "short": "-l", "long": "--list-shells", "description": "List the shells in /etc/shells" },
    { "short": "-h", "long": "--help", "description": "Show help" },
    { "short": "-v", "long": "--version", "description": "Show version" }
  ],
  "arguments": [
    {
      "name": "user",
      "description": "User whose shell is changed",
      "required": false,
      "type": { "type": "User" }
    }
  ]
}
