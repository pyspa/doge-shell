{
  "command": "conntrack",
  "description": "Netfilter connection tracking command line interface",
  "global_options": [
    {
      "short": "-L",
      "long": "--dump",
      "description": "List connection tracking entries"
    },
    {
      "short": "-D",
      "long": "--delete",
      "description": "Delete entries"
    },
    {
      "short": "-E",
      "long": "--event",
      "description": "Show events"
    },
    {
      "short": "-F",
      "long": "--flush",
      "description": "Flush table"
    },
    {
      "short": "-p",
      "long": "--proto",
      "description": "Layer 4 protocol",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "tcp",
          "udp",
          "icmp",
          "icmpv6",
          "sctp",
          "dccp",
          "gre"
        ]
      }
    },
    {
      "short": "-s",
      "long": "--orig-src",
      "description": "Original source address",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-d",
      "long": "--orig-dst",
      "description": "Original destination address",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--reply-src",
      "description": "Reply source address",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--reply-dst",
      "description": "Reply destination address",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-o",
      "long": "--output",
      "description": "Output format",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "default",
          "extended",
          "xml",
          "timestamp",
          "id"
        ]
      }
    },
    {
      "short": "-U",
      "long": "--update",
      "description": "Update an existing conntrack entry"
    },
    {
      "short": "-I",
      "long": "--create",
      "description": "Create a conntrack entry"
    },
    {
      "short": "-G",
      "long": "--get",
      "description": "Look up a conntrack entry"
    },
    {
      "short": "-C",
      "long": "--count",
      "description": "Show the current number of entries"
    },
    {
      "short": "-S",
      "long": "--stats",
      "description": "Show per-CPU statistics"
    },
    {
      "short": "-f",
      "long": "--family",
      "description": "Address family",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "ipv4",
          "ipv6"
        ]
      }
    },
    {
      "short": "-n",
      "long": "--src-nat",
      "description": "Match source NAT entries"
    },
    {
      "short": "-g",
      "long": "--dst-nat",
      "description": "Match destination NAT entries"
    }
  ]
}
