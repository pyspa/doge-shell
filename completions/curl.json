{
  "command": "curl",
  "short_option_clusters": true,
  "description": "Transfer data from or to a server using URL syntax",
  "global_options": [
    {
      "long": "--help",
      "short": "-h",
      "description": "Display help information"
    },
    {
      "long": "--version",
      "short": "-V",
      "description": "Display version information"
    },
    {
      "long": "--verbose",
      "short": "-v",
      "description": "Enable verbose output",
      "multiple": true
    },
    {
      "long": "--silent",
      "short": "-s",
      "description": "Silent mode (no output except errors)"
    },
    {
      "short": "-X",
      "long": "--request",
      "description": "Specify request method (e.g., GET, POST)",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-H",
      "long": "--header",
      "description": "Pass custom header line to server",
      "takes_value": true,
      "value_type": {
        "type": "String"
      },
      "multiple": true
    },
    {
      "short": "-d",
      "long": "--data",
      "description": "HTTP POST data",
      "takes_value": true,
      "value_type": {
        "type": "String"
      },
      "multiple": true
    },
    {
      "short": "-o",
      "long": "--output",
      "description": "Write output to file instead of stdout",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      },
      "multiple": true
    },
    {
      "short": "-k",
      "long": "--insecure",
      "description": "Allow connections to servers with invalid certificates"
    },
    {
      "short": "-L",
      "long": "--location",
      "description": "Follow redirects"
    },
    {
      "short": "-u",
      "long": "--user",
      "description": "Server user and password",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    }
  ],
  "subcommands": []
}
