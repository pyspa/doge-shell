{
  "command": "doctor",
  "description": "Diagnose doge-shell setup and runtime state",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "config", "description": "Check config" },
    { "name": "ai", "description": "Check AI configuration" },
    { "name": "mcp", "description": "Check MCP servers" },
    { "name": "project", "description": "Check project context" },
    { "name": "runtime", "aliases": ["runtimes"], "description": "Check developer tools" },
    { "name": "performance", "aliases": ["perf"], "description": "Check performance", "options": [{ "long": "--latency", "description": "Run latency probe" }, { "long": "--latency-iters", "description": "Latency iterations", "takes_value": true, "value_type": { "type": "Number" } }] },
    { "name": "skills", "description": "Check runtime skills" },
    { "name": "safety", "description": "Check safety posture" },
    { "name": "setup", "description": "Show first-run setup state" },
    { "name": "fix", "description": "Create safe missing setup files" },
    { "name": "dev", "aliases": ["validate"], "description": "Suggest validation commands" }
  ]
}
