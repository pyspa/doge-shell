{
  "command": "etcdctl",
  "description": "Control the etcd cluster",
  "global_options": [
    { "long": "--endpoints", "description": "Comma-separated gRPC endpoints", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-w", "long": "--write-out", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["simple", "json", "fields", "protobuf", "table"] } },
    { "long": "--user", "description": "Username for authentication", "takes_value": true, "value_type": { "type": "User" } },
    { "long": "--command-timeout", "description": "Command timeout", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    {
      "name": "get",
      "description": "Get a key or prefix",
      "options": [
        { "long": "--prefix", "description": "Get keys with matching prefix" },
        { "long": "--keys-only", "description": "Return keys only" },
        { "long": "--rev", "description": "Fetch at a specific revision", "takes_value": true, "value_type": { "type": "Number" } },
        { "long": "--limit", "description": "Maximum number of results", "takes_value": true, "value_type": { "type": "Number" } }
      ],
      "arguments": [{ "name": "key", "description": "Key or prefix", "type": { "type": "String" } }]
    },
    {
      "name": "put",
      "description": "Put a key value",
      "arguments": [
        { "name": "key", "description": "Key", "required": true, "type": { "type": "String" } },
        { "name": "value", "description": "Value", "required": true, "type": { "type": "String" } }
      ]
    },
    {
      "name": "del",
      "description": "Delete a key or prefix",
      "options": [{ "long": "--prefix", "description": "Delete keys with matching prefix" }],
      "arguments": [{ "name": "key", "description": "Key or prefix", "type": { "type": "String" } }]
    },
    { "name": "txn", "description": "Run a transaction from stdin" },
    { "name": "compaction", "description": "Compact the event history", "arguments": [{ "name": "revision", "type": { "type": "Number" } }] },
    { "name": "defrag", "description": "Defragment the backing store" },
    { "name": "alarm", "description": "Manage alarms", "subcommands": [{ "name": "disarm", "description": "Disarm alarms" }, { "name": "list", "description": "List alarms" }] },
    { "name": "endpoint", "description": "Check endpoint state", "subcommands": [{ "name": "health", "description": "Health check" }, { "name": "status", "description": "Cluster status" }, { "name": "hashkv", "description": "KV store hash" }] },
    { "name": "lease", "description": "Manage leases", "subcommands": [{ "name": "grant", "description": "Grant a lease" }, { "name": "revoke", "description": "Revoke a lease" }, { "name": "keep-alive", "description": "Keep a lease alive" }, { "name": "list", "description": "List leases" }] },
    { "name": "member", "description": "Manage members", "subcommands": [{ "name": "add", "description": "Add a member" }, { "name": "remove", "description": "Remove a member" }, { "name": "update", "description": "Update a member" }, { "name": "list", "description": "List members" }] },
    { "name": "snapshot", "description": "Manage snapshots", "subcommands": [{ "name": "save", "description": "Save a snapshot", "arguments": [{ "name": "file", "description": "Snapshot file", "type": { "type": "File", "data": {} } }] }, { "name": "restore", "description": "Restore a snapshot", "arguments": [{ "name": "file", "description": "Snapshot file", "required": true, "type": { "type": "File", "data": {} } }] }, { "name": "status", "description": "Show snapshot status" }] },
    { "name": "watch", "description": "Watch key changes", "options": [{ "long": "--prefix", "description": "Watch by prefix" }, { "short": "-i", "long": "--interactive", "description": "Interactive mode" }], "arguments": [{ "name": "key", "description": "Key or range", "type": { "type": "String" } }] },
    { "name": "user", "description": "Manage users", "subcommands": [{ "name": "add", "description": "Add a user" }, { "name": "delete", "description": "Delete a user" }, { "name": "list", "description": "List users" }, { "name": "grant-role", "description": "Grant a role" }, { "name": "revoke-role", "description": "Revoke a role" }] },
    { "name": "role", "description": "Manage roles", "subcommands": [{ "name": "add", "description": "Add a role" }, { "name": "delete", "description": "Delete a role" }, { "name": "list", "description": "List roles" }, { "name": "grant-permission", "description": "Grant a permission" }] },
    { "name": "auth", "description": "Manage authentication", "subcommands": [{ "name": "enable", "description": "Enable auth" }, { "name": "disable", "description": "Disable auth" }, { "name": "status", "description": "Show auth status" }] },
    { "name": "move-leader", "description": "Move leadership to a member", "arguments": [{ "name": "member-id", "type": { "type": "String" } }] },
    { "name": "version", "description": "Print version" }
  ]
}
