{
  "command": "gh",
  "description": "GitHub CLI",
  "global_options": [
    {
      "short": "-R",
      "long": "--repo",
      "description": "Select another repository",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "gh.repository" } }
    },
    {
      "long": "--help",
      "description": "Show help"
    },
    {
      "long": "--version",
      "description": "Show version"
    }
  ],
  "subcommands": [
    {
      "name": "pr",
      "description": "Manage pull requests",
      "subcommands": [
        {
          "name": "list",
          "description": "List pull requests",
          "options": [
            { "short": "-s", "long": "--state", "description": "Filter by state (open, closed, merged, all)" },
            { "short": "-l", "long": "--label", "description": "Filter by label" },
            { "short": "-a", "long": "--author", "description": "Filter by author" },
            { "short": "-A", "long": "--assignee", "description": "Filter by assignee", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-B", "long": "--base", "description": "Filter by base branch", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-H", "long": "--head", "description": "Filter by head branch", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-L", "long": "--limit", "description": "Maximum number of items", "takes_value": true, "value_type": { "type": "Number" } },
            { "short": "-S", "long": "--search", "description": "Search pull requests", "takes_value": true, "value_type": { "type": "String" } },
            { "long": "--draft", "description": "Filter by draft state" }
          ]
        },
        {
          "name": "view",
          "description": "View a pull request",
          "arguments": [
            {
              "name": "number",
              "description": "PR number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } }
            }
          ]
        },
        {
          "name": "checkout",
          "description": "Check out a pull request locally",
          "arguments": [
            {
              "name": "number",
              "description": "PR number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } }
            }
          ]
        },
        { "name": "create", "description": "Create a pull request" },
        { "name": "close", "description": "Close a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "merge", "description": "Merge a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "ready", "description": "Mark a pull request as ready for review", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "diff", "description": "View changes in a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "comment", "description": "Add a comment to a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] }
      ]
    },
    {
      "name": "issue",
      "description": "Manage issues",
      "subcommands": [
        {
          "name": "list",
          "description": "List issues",
          "options": [
            { "short": "-s", "long": "--state", "description": "Filter by state (open, closed, all)" },
            { "short": "-l", "long": "--label", "description": "Filter by label" },
            { "short": "-a", "long": "--assignee", "description": "Filter by assignee" }
          ]
        },
        {
          "name": "view",
          "description": "View an issue",
          "arguments": [
            {
              "name": "number",
              "description": "Issue number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } }
            }
          ]
        },
        { "name": "create", "description": "Create an issue" },
        { "name": "close", "description": "Close an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] },
        { "name": "reopen", "description": "Reopen an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] },
        { "name": "comment", "description": "Add a comment to an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] }
      ]
    },
    {
      "name": "repo",
      "description": "Manage repositories",
      "subcommands": [
        { "name": "clone", "description": "Clone a repository", "arguments": [{ "name": "repository", "type": { "type": "Dynamic", "data": { "provider": "gh.repository" } } }] },
        { "name": "create", "description": "Create a repository" },
        { "name": "fork", "description": "Fork a repository" },
        { "name": "view", "description": "View a repository", "arguments": [{ "name": "repository", "type": { "type": "Dynamic", "data": { "provider": "gh.repository" } } }] },
        { "name": "list", "description": "List repositories" }
      ]
    },
    {
      "name": "workflow",
      "description": "View and run GitHub Actions workflows",
      "subcommands": [
        { "name": "list", "description": "List workflows" },
        { "name": "run", "description": "Run a workflow", "arguments": [{ "name": "workflow", "type": { "type": "Dynamic", "data": { "provider": "gh.workflow" } } }] },
        { "name": "view", "description": "View a workflow", "arguments": [{ "name": "workflow", "type": { "type": "Dynamic", "data": { "provider": "gh.workflow" } } }] }
      ]
    },
    {
      "name": "run",
      "description": "View and manage workflow runs",
      "subcommands": [
        { "name": "list", "description": "List workflow runs" },
        {
          "name": "view",
          "description": "View a specific run",
          "arguments": [
            {
              "name": "run_id",
              "description": "Run ID",
              "type": { "type": "Dynamic", "data": { "provider": "gh.run" } }
            }
          ]
        },
        { "name": "watch", "description": "Watch a run until it completes", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "download", "description": "Download artifacts from a run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "rerun", "description": "Rerun a failed run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "cancel", "description": "Cancel a workflow run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] }
      ]
    },
    {
      "name": "auth",
      "description": "Authenticate with GitHub",
      "subcommands": [
        { "name": "login", "description": "Authenticate with a GitHub host" },
        { "name": "logout", "description": "Log out of a GitHub host" },
        { "name": "status", "description": "View authentication status" },
        { "name": "refresh", "description": "Refresh stored authentication" }
      ]
    },
    {
      "name": "browse",
      "description": "Open repository in web browser"
    },
    {
      "name": "gist",
      "description": "Manage gists",
      "subcommands": [
        { "name": "create", "description": "Create a gist" },
        { "name": "list", "description": "List gists" },
        { "name": "view", "description": "View a gist" },
        { "name": "edit", "description": "Edit a gist" },
        { "name": "delete", "description": "Delete a gist" }
      ]
    },
    {
      "name": "release",
      "description": "Manage releases",
      "subcommands": [
        { "name": "create", "description": "Create a new release" },
        { "name": "list", "description": "List releases in a repository" },
        { "name": "view", "description": "View information about a release" },
        { "name": "edit", "description": "Edit a release" },
        { "name": "delete", "description": "Delete a release" },
        { "name": "download", "description": "Download release assets" },
        { "name": "upload", "description": "Upload assets to a release" }
      ]
    },
    {
      "name": "api",
      "description": "Make an authenticated GitHub API request",
      "options": [
        { "long": "--method", "short": "-X", "description": "HTTP method", "takes_value": true, "value_type": { "type": "Choice", "data": ["GET", "POST", "PUT", "PATCH", "DELETE"] } },
        { "long": "--input", "description": "Read the request body from a file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
        { "long": "--header", "short": "-H", "description": "Add an HTTP request header", "takes_value": true, "value_type": { "type": "String" } }
      ],
      "arguments": [
        { "name": "endpoint", "description": "API endpoint path" }
      ]
    },
    {
      "name": "search",
      "description": "Search for repositories, issues, and pull requests",
      "subcommands": [
        { "name": "repos", "description": "Search for repositories" },
        { "name": "issues", "description": "Search for issues" },
        { "name": "prs", "description": "Search for pull requests" },
        { "name": "commits", "description": "Search for commits" },
        { "name": "code", "description": "Search for code" }
      ]
    },
    {
      "name": "label",
      "description": "Manage labels",
      "subcommands": [
        { "name": "list", "description": "List labels in a repository" },
        { "name": "create", "description": "Create a new label" },
        { "name": "edit", "description": "Edit a label" },
        { "name": "delete", "description": "Delete a label" }
      ]
    },
    {
      "name": "secret",
      "description": "Manage GitHub secrets",
      "subcommands": [
        { "name": "set", "description": "Set a secret" },
        { "name": "list", "description": "List secrets" },
        { "name": "delete", "description": "Delete secrets" }
      ]
    },
    {
      "name": "variable",
      "description": "Manage GitHub Actions variables",
      "subcommands": [
        { "name": "set", "description": "Set a variable" },
        { "name": "list", "description": "List variables" },
        { "name": "get", "description": "Get a variable" },
        { "name": "delete", "description": "Delete variables" }
      ]
    },
    {
      "name": "status",
      "description": "Print information about relevant issues, pull requests, and notifications across repositories"
    },
    {
      "name": "config",
      "description": "Manage configuration for gh",
      "subcommands": [
        { "name": "get", "description": "Print the value of a given configuration key" },
        { "name": "set", "description": "Update configuration with a value for the given key" },
        { "name": "list", "description": "Print a list of set configuration keys" }
      ]
    },
    {
      "name": "alias",
      "description": "Create command shortcuts",
      "subcommands": [
        { "name": "set", "description": "Create a shorthand for a gh command" },
        { "name": "list", "description": "List your aliases" },
        { "name": "delete", "description": "Delete set aliases" },
        { "name": "import", "description": "Import aliases from a YAML file" }
      ]
    },
    {
      "name": "extension",
      "description": "Manage gh extensions",
      "subcommands": [
        { "name": "install", "description": "Install a gh extension from a repository" },
        { "name": "list", "description": "List installed extension commands" },
        { "name": "upgrade", "description": "Upgrade installed extensions" },
        { "name": "remove", "description": "Remove an installed extension" }
      ]
    },
    {
      "name": "codespace",
      "description": "Connect to and manage codespaces",
      "subcommands": [
        { "name": "list", "description": "List codespaces" },
        { "name": "create", "description": "Create a codespace" },
        { "name": "delete", "description": "Delete codespaces" },
        { "name": "code", "description": "Open a codespace in Visual Studio Code" },
        { "name": "ssh", "description": "SSH into a codespace" },
        { "name": "stop", "description": "Stop a running codespace" }
      ]
    },
    {
      "name": "project",
      "description": "Work with GitHub Projects",
      "subcommands": [
        { "name": "list", "description": "List the projects for an owner" },
        { "name": "create", "description": "Create a project" },
        { "name": "view", "description": "View a project" },
        { "name": "close", "description": "Close a project" },
        { "name": "delete", "description": "Delete a project" }
      ]
    },
    {
      "name": "org",
      "description": "Manage organizations",
      "subcommands": [
        { "name": "list", "description": "List organizations for the authenticated user" }
      ]
    },
    {
      "name": "discussion",
      "description": "Work with GitHub Discussions",
      "subcommands": [
        { "name": "list", "description": "List discussions in a repository" },
        { "name": "create", "description": "Create a new discussion" },
        { "name": "view", "description": "View a discussion" },
        { "name": "close", "description": "Close a discussion" }
      ]
    },
    {
      "name": "gpg-key",
      "description": "Manage GPG keys",
      "subcommands": [
        { "name": "add", "description": "Add a GPG key to your GitHub account" },
        { "name": "list", "description": "Lists GPG keys in your GitHub account" },
        { "name": "delete", "description": "Delete a GPG key from your GitHub account" }
      ]
    },
    {
      "name": "ssh-key",
      "description": "Manage SSH keys",
      "subcommands": [
        { "name": "add", "description": "Add an SSH key to your GitHub account" },
        { "name": "list", "description": "Lists SSH keys in your GitHub account" },
        { "name": "delete", "description": "Delete an SSH key from your GitHub account" }
      ]
    }
  ]
}
