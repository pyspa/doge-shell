{
  "command": "git-lfs",
  "description": "Git Large File Storage",
  "global_options": [
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-v",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install Git LFS hooks"
    },
    {
      "name": "uninstall",
      "description": "Remove Git LFS hooks"
    },
    {
      "name": "track",
      "description": "Track file patterns",
      "arguments": [
        {
          "name": "pattern",
          "description": "Path pattern",
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "untrack",
      "description": "Stop tracking file patterns",
      "arguments": [
        {
          "name": "pattern",
          "description": "Path pattern",
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "ls-files",
      "description": "Show LFS tracked files"
    },
    {
      "name": "status",
      "description": "Show LFS status"
    },
    {
      "name": "fetch",
      "description": "Fetch LFS objects",
      "arguments": [
        {
          "name": "remote",
          "description": "Git remote",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote"
            }
          }
        }
      ]
    },
    {
      "name": "pull",
      "description": "Fetch and checkout LFS objects",
      "arguments": [
        {
          "name": "remote",
          "description": "Git remote",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote"
            }
          }
        }
      ]
    },
    {
      "name": "push",
      "description": "Push LFS objects",
      "arguments": [
        {
          "name": "remote",
          "description": "Git remote",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote"
            }
          }
        }
      ]
    },
    {
      "name": "migrate",
      "description": "Import or export Git history with LFS",
      "subcommands": [
        {
          "name": "import",
          "description": "Convert existing history to Git LFS"
        },
        {
          "name": "export",
          "description": "Convert Git LFS pointers back to files"
        },
        {
          "name": "info",
          "description": "Show migration statistics"
        }
      ],
      "options": [
        {
          "long": "--include-ref",
          "description": "Include the given ref",
          "takes_value": true,
          "multiple": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision"
            }
          }
        },
        {
          "long": "--exclude-ref",
          "description": "Exclude the given ref",
          "takes_value": true,
          "multiple": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision"
            }
          }
        },
        {
          "long": "--everything",
          "description": "Migrate every local ref"
        }
      ]
    },
    {
      "name": "prune",
      "description": "Delete old LFS files from local storage"
    },
    {
      "name": "env",
      "description": "Show the Git LFS environment"
    },
    {
      "name": "lock",
      "description": "Lock a file",
      "arguments": [
        {
          "name": "path",
          "description": "Path to lock",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.changed_path"
            }
          }
        }
      ]
    },
    {
      "name": "unlock",
      "description": "Unlock a file",
      "arguments": [
        {
          "name": "path",
          "description": "Path to unlock",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.changed_path"
            }
          }
        }
      ]
    },
    {
      "name": "locks",
      "description": "List currently locked files"
    },
    {
      "name": "checkout",
      "description": "Populate working copy with LFS file contents"
    }
  ]
}
