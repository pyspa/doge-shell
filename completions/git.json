{
  "command": "git",
  "description": "Distributed version control system",
  "global_options": [
    {
      "short": "-v",
      "long": "--version",
      "description": "Show version info"
    },
    {
      "long": "--help",
      "description": "Show help info"
    },
    {
      "short": "-C",
      "description": "Run as if git was started in <path>"
    },
    {
      "short": "-c",
      "description": "Pass a configuration parameter to command"
    },
    {
      "long": "--exec-path",
      "description": "Path to wherever your core git programs are installed"
    },
    {
      "long": "--html-path",
      "description": "Path to wherever your html documentation are installed"
    },
    {
      "long": "--man-path",
      "description": "Path to wherever your man pages are installed"
    },
    {
      "long": "--info-path",
      "description": "Path to wherever your info pages are installed"
    },
    {
      "short": "-p",
      "long": "--paginate",
      "description": "Pipe all output into less"
    },
    {
      "long": "--no-pager",
      "description": "Do not pipe git output into a pager"
    },
    {
      "long": "--no-replace-objects",
      "description": "Do not use replacement refs to replace git objects"
    },
    {
      "long": "--bare",
      "description": "Treat the repository as a bare repository"
    },
    {
      "long": "--git-dir",
      "description": "Set the path to the repository"
    },
    {
      "long": "--work-tree",
      "description": "Set the path to the working tree"
    },
    {
      "long": "--namespace",
      "description": "Set the git namespace"
    }
  ],
  "subcommands": [
    {
      "name": "commit",
      "description": "Record changes to the repository",
      "options": [
        {
          "short": "-a",
          "long": "--all",
          "description": "Stage all modified and deleted paths"
        },
        {
          "short": "-m",
          "long": "--message",
          "description": "Use the given <msg> as the commit message"
        },
        {
          "long": "--amend",
          "description": "Amend the previous commit"
        }
      ]
    },
    {
      "name": "config",
      "description": "Get and set repository or global options",
      "options": [
        {
          "long": "--global",
          "description": "Use the global config file"
        },
        {
          "long": "--system",
          "description": "Use the system config file"
        },
        {
          "long": "--local",
          "description": "Use the repository config file"
        },
        {
          "long": "--worktree",
          "description": "Use the worktree config file"
        },
        {
          "long": "--get",
          "description": "Get a value"
        },
        {
          "long": "--get-all",
          "description": "Get all values for a key"
        },
        {
          "long": "--unset",
          "description": "Remove a value"
        },
        {
          "long": "--unset-all",
          "description": "Remove all values for a key"
        },
        {
          "short": "-l",
          "long": "--list",
          "description": "List all variables"
        },
        {
          "long": "--show-origin",
          "description": "Show the origin of each value"
        },
        {
          "long": "--name-only",
          "description": "Show variable names only"
        }
      ],
      "arguments": [
        {
          "name": "key",
          "description": "Configuration key",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.config_key"
            }
          }
        },
        {
          "name": "value",
          "description": "Configuration value",
          "required": false
        }
      ]
    },
    {
      "name": "switch",
      "description": "Switch branches",
      "arguments": [
        {
          "name": "branch",
          "description": "Branch to switch to",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.branch",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "checkout",
      "description": "Switch branches or restore working tree files",
      "arguments": [
        {
          "name": "branch_or_file",
          "description": "Branch to checkout",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.checkout_target",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "add",
      "description": "Add file contents to the index",
      "arguments": [
        {
          "name": "file",
          "description": "Files to add",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.changed_path",
              "scope": "project"
            }
          }
        }
      ],
      "options": [
        {
          "short": "-A",
          "long": "--all",
          "description": "Add all changes"
        },
        {
          "short": "-u",
          "long": "--update",
          "description": "Update staged files"
        },
        {
          "short": "-p",
          "long": "--patch",
          "description": "Interactively choose hunks of patch"
        },
        {
          "short": "-N",
          "long": "--intent-to-add",
          "description": "Record only the fact that the path will be added later"
        },
        {
          "short": "-n",
          "long": "--dry-run",
          "description": "Don't actually add the file(s), just show if they exist"
        }
      ]
    },
    {
      "name": "status",
      "description": "Show the working tree status"
    },
    {
      "name": "push",
      "description": "Update remote refs along with associated objects",
      "arguments": [
        {
          "name": "remote",
          "description": "Remote repository",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote",
              "scope": "project"
            }
          }
        },
        {
          "name": "branch",
          "description": "Branch to push",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.push_branch",
              "scope": "project"
            }
          }
        }
      ],
      "options": [
        {
          "short": "-f",
          "long": "--force",
          "description": "Force updates"
        },
        {
          "long": "--force-with-lease",
          "description": "Require old value of ref to be at this value"
        },
        {
          "long": "--force-if-includes",
          "description": "Require remote updates to be integrated locally"
        },
        {
          "short": "-u",
          "long": "--set-upstream",
          "description": "Set upstream for git pull/status"
        },
        {
          "short": "-n",
          "long": "--dry-run",
          "description": "Dry run"
        },
        {
          "long": "--tags",
          "description": "Push tags (can't be used with --all or --mirror)"
        },
        {
          "long": "--follow-tags",
          "description": "Push missing but relevant tags"
        },
        {
          "long": "--all",
          "description": "Push all branches"
        },
        {
          "long": "--mirror",
          "description": "Mirror all refs"
        },
        {
          "short": "-d",
          "long": "--delete",
          "description": "Delete refs"
        },
        {
          "long": "--prune",
          "description": "Prune locally removed refs"
        },
        {
          "long": "--atomic",
          "description": "Request atomic transaction on remote side"
        },
        {
          "long": "--verify",
          "description": "Run the pre-push hook"
        },
        {
          "long": "--no-verify",
          "description": "Bypass the pre-push hook"
        },
        {
          "long": "--porcelain",
          "description": "Machine-readable output"
        },
        {
          "long": "--progress",
          "description": "Force progress reporting"
        },
        {
          "long": "--signed",
          "description": "GPG sign the push"
        },
        {
          "long": "--thin",
          "description": "Use thin pack"
        },
        {
          "short": "-q",
          "long": "--quiet",
          "description": "Be more quiet"
        },
        {
          "short": "-4",
          "long": "--ipv4",
          "description": "Use IPv4 addresses only"
        },
        {
          "short": "-6",
          "long": "--ipv6",
          "description": "Use IPv6 addresses only"
        },
        {
          "short": "-o",
          "long": "--push-option",
          "description": "Option to transmit",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "long": "--receive-pack",
          "description": "Receive pack program",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "long": "--repo",
          "description": "Repository to push to",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote",
              "scope": "project"
            }
          }
        },
        {
          "long": "--recurse-submodules",
          "description": "Control recursive pushing of submodules",
          "takes_value": true,
          "value_type": {
            "type": "Choice",
            "data": ["check", "on-demand", "only", "no"]
          }
        }
      ]
    },
    {
      "name": "pull",
      "description": "Fetch from and integrate with another repository or a local branch",
      "arguments": [
        {
          "name": "remote",
          "description": "Remote repository",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote",
              "scope": "project"
            }
          }
        },
        {
          "name": "branch",
          "description": "Branch to pull",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote_branch",
              "scope": "project"
            }
          }
        }
      ],
      "options": [
        {
          "short": "-r",
          "long": "--rebase",
          "description": "Incorporate changes by rebasing rather than merging"
        },
        {
          "long": "--no-rebase",
          "description": "Incorporate changes by merging rather than rebasing"
        },
        {
          "long": "--ff",
          "description": "Allow fast-forward"
        },
        {
          "long": "--no-ff",
          "description": "Create a merge commit even for a fast-forward"
        },
        {
          "long": "--ff-only",
          "description": "Abort if fast-forward is not possible"
        },
        {
          "long": "--squash",
          "description": "Create a single commit instead of doing a merge"
        },
        {
          "long": "--autostash",
          "description": "Automatically stash/stash pop before and after"
        },
        {
          "long": "--no-commit",
          "description": "Don't commit automatically after a successful merge"
        },
        {
          "long": "--no-edit",
          "description": "Don't edit the merge commit message"
        },
        {
          "long": "--all",
          "description": "Fetch from all remotes"
        },
        {
          "short": "-t",
          "long": "--tags",
          "description": "Fetch all tags and associated objects"
        },
        {
          "short": "-p",
          "long": "--prune",
          "description": "Prune remote-tracking branches no longer on remote"
        },
        {
          "short": "-f",
          "long": "--force",
          "description": "Force overwrite of local branch"
        },
        {
          "long": "--dry-run",
          "description": "Dry run"
        },
        {
          "long": "--unshallow",
          "description": "Convert to a complete repository"
        },
        {
          "short": "-q",
          "long": "--quiet",
          "description": "Be more quiet"
        },
        {
          "long": "--progress",
          "description": "Force progress reporting"
        },
        {
          "short": "-S",
          "long": "--gpg-sign",
          "description": "GPG sign commit"
        },
        {
          "long": "--verify-signatures",
          "description": "Verify that the named commit has a valid GPG signature"
        },
        {
          "long": "--depth",
          "description": "Deepen history of shallow clone",
          "takes_value": true,
          "value_type": {
            "type": "Number"
          }
        },
        {
          "short": "-s",
          "long": "--strategy",
          "description": "Merge strategy to use",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "short": "-X",
          "long": "--strategy-option",
          "description": "Option for selected merge strategy",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "long": "--recurse-submodules",
          "description": "Control recursive fetching of submodules",
          "takes_value": true,
          "value_type": {
            "type": "Choice",
            "data": ["yes", "on-demand", "no"]
          }
        }
      ]
    },
    {
      "name": "fetch",
      "description": "Download objects and refs from another repository",
      "arguments": [
        {
          "name": "remote",
          "description": "Remote repository",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote",
              "scope": "project"
            }
          }
        },
        {
          "name": "branch",
          "description": "Branch to fetch",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.remote_branch",
              "scope": "project"
            }
          }
        }
      ],
      "options": [
        {
          "long": "--all",
          "description": "Fetch from all remotes"
        },
        {
          "short": "-p",
          "long": "--prune",
          "description": "Prune remote-tracking branches no longer on remote"
        },
        {
          "short": "-P",
          "long": "--prune-tags",
          "description": "Prune local tags no longer on remote and clobber changed tags"
        },
        {
          "short": "-t",
          "long": "--tags",
          "description": "Fetch all tags and associated objects"
        },
        {
          "long": "--no-tags",
          "description": "Disable automatic tag following"
        },
        {
          "short": "-f",
          "long": "--force",
          "description": "Force overwrite of local reference"
        },
        {
          "long": "--dry-run",
          "description": "Dry run"
        },
        {
          "long": "--atomic",
          "description": "Use atomic transaction to update references"
        },
        {
          "long": "--unshallow",
          "description": "Convert to a complete repository"
        },
        {
          "long": "--refetch",
          "description": "Re-fetch without negotiating common commits"
        },
        {
          "long": "--set-upstream",
          "description": "Set upstream for git pull/fetch"
        },
        {
          "long": "--multiple",
          "description": "Fetch from multiple remotes"
        },
        {
          "long": "--porcelain",
          "description": "Machine-readable output"
        },
        {
          "short": "-q",
          "long": "--quiet",
          "description": "Be more quiet"
        },
        {
          "long": "--progress",
          "description": "Force progress reporting"
        },
        {
          "long": "--depth",
          "description": "Deepen history of shallow clone",
          "takes_value": true,
          "value_type": {
            "type": "Number"
          }
        },
        {
          "long": "--deepen",
          "description": "Deepen history of shallow clone by <n> commits",
          "takes_value": true,
          "value_type": {
            "type": "Number"
          }
        },
        {
          "short": "-j",
          "long": "--jobs",
          "description": "Number of submodules fetched in parallel",
          "takes_value": true,
          "value_type": {
            "type": "Number"
          }
        },
        {
          "long": "--filter",
          "description": "Object filtering",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "long": "--recurse-submodules",
          "description": "Control recursive fetching of submodules",
          "takes_value": true,
          "value_type": {
            "type": "Choice",
            "data": ["yes", "on-demand", "no"]
          }
        }
      ]
    },
    {
      "name": "merge",
      "description": "Join two or more development histories together",
      "arguments": [
        {
          "name": "branch",
          "description": "Branch to merge",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.branch",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "rebase",
      "description": "Reapply commits on top of another base tip",
      "arguments": [
        {
          "name": "branch",
          "description": "Branch to rebase onto",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.branch",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "log",
      "description": "Show commit logs",
      "arguments": [
        {
          "name": "revision",
          "description": "Revision to show",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "diff",
      "description": "Show changes between commits, commit and working tree, etc",
      "arguments": [
        {
          "name": "revision",
          "description": "Revision or file",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "show",
      "description": "Show various types of objects",
      "arguments": [
        {
          "name": "object",
          "description": "Object to show",
          "required": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "reset",
      "description": "Reset current HEAD to the specified state",
      "arguments": [
        {
          "name": "commit",
          "description": "Commit to reset to",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "branch",
      "description": "List, create, or delete branches",
      "arguments": [
        {
          "name": "branchname",
          "description": "Branch name",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.branch",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "tag",
      "description": "Create, list, delete or verify a tag object signed with GPG",
      "arguments": [
        {
          "name": "tagname",
          "description": "Tag name",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.tag",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "stash",
      "description": "Stash the changes in a dirty working directory away",
      "subcommands": [
        {
          "name": "list",
          "description": "List the stash entries",
          "arguments": []
        },
        {
          "name": "pop",
          "description": "Remove a single stashed state from the stash list and apply it",
          "arguments": [
            {
              "name": "stash",
              "description": "Stash to pop",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.stash",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "apply",
          "description": "Like pop, but do not remove the state from the stash list",
          "arguments": [
            {
              "name": "stash",
              "description": "Stash to apply",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.stash",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "drop",
          "description": "Remove a single stashed state from the stash list",
          "arguments": [
            {
              "name": "stash",
              "description": "Stash to drop",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.stash",
                  "scope": "project"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "restore",
      "description": "Restore working tree files",
      "options": [
        {
          "short": "-s",
          "long": "--source",
          "description": "Restore from the given tree-ish",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.revision",
              "scope": "project"
            }
          }
        },
        {
          "short": "-S",
          "long": "--staged",
          "description": "Restore the content in the staging area"
        },
        {
          "short": "-W",
          "long": "--worktree",
          "description": "Restore the content in the working tree"
        },
        {
          "short": "-p",
          "long": "--patch",
          "description": "Interactively restore hunks"
        }
      ],
      "arguments": [
        {
          "name": "pathspec",
          "description": "Files to restore",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "git.changed_path",
              "scope": "project"
            }
          }
        }
      ]
    },
    {
      "name": "worktree",
      "description": "Manage multiple working trees",
      "subcommands": [
        {
          "name": "add",
          "description": "Create a new worktree",
          "arguments": [
            {
              "name": "path",
              "description": "Path for new worktree",
              "type": {
                "type": "Directory"
              }
            },
            {
              "name": "branch",
              "description": "Branch to checkout",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.branch",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "list",
          "description": "List worktrees"
        },
        {
          "name": "remove",
          "description": "Remove a worktree",
          "arguments": [
            {
              "name": "worktree",
              "description": "Worktree to remove",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.worktree",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "prune",
          "description": "Prune worktree information"
        }
      ]
    },
    {
      "name": "remote",
      "description": "Manage set of tracked repositories",
      "subcommands": [
        {
          "name": "add",
          "description": "Add a new remote"
        },
        {
          "name": "remove",
          "description": "Remove a remote",
          "arguments": [
            {
              "name": "name",
              "description": "Remote to remove",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.remote",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "rename",
          "description": "Rename a remote"
        },
        {
          "name": "show",
          "description": "Show information about remotes",
          "arguments": [
            {
              "name": "remote",
              "description": "Remote to show",
              "type": {
                "type": "Dynamic",
                "data": {
                  "provider": "git.remote",
                  "scope": "project"
                }
              }
            }
          ]
        },
        {
          "name": "-v",
          "description": "List remotes verbosely"
        }
      ]
    },
    {
      "name": "clone",
      "description": "Clone a repository into a new directory",
      "options": [
        {
          "long": "--depth",
          "description": "Create shallow clone with specified depth"
        },
        {
          "short": "-b",
          "long": "--branch",
          "description": "Branch to checkout"
