{
  "command": "glab",
  "description": "GitLab CLI",
  "global_options": [
    { "short": "-R", "long": "--repo", "description": "Repository", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "glab.project" } } },
    { "short": "-h", "long": "--help", "description": "Show help" },
    { "short": "-v", "long": "--version", "description": "Show version" }
  ],
  "subcommands": [
    { "name": "auth", "description": "Authenticate glab", "subcommands": [{ "name": "login", "description": "Log in" }, { "name": "status", "description": "View auth status" }] },
    { "name": "repo", "description": "Manage repositories", "subcommands": [{ "name": "clone", "description": "Clone a repository", "arguments": [{ "name": "project", "type": { "type": "Dynamic", "data": { "provider": "glab.project" } } }] }, { "name": "view", "description": "View a repository", "arguments": [{ "name": "project", "type": { "type": "Dynamic", "data": { "provider": "glab.project" } } }] }, { "name": "list", "description": "List repositories" }] },
    { "name": "mr", "description": "Manage merge requests", "subcommands": [{ "name": "list", "description": "List merge requests", "options": [{ "short": "-a", "long": "--assignee", "description": "Filter by assignee", "takes_value": true, "value_type": { "type": "String" } }, { "short": "-r", "long": "--reviewer", "description": "Filter by reviewer", "takes_value": true, "value_type": { "type": "String" } }, { "short": "-l", "long": "--label", "description": "Filter by label", "takes_value": true, "value_type": { "type": "String" } }, { "short": "-P", "long": "--per-page", "description": "Items per page", "takes_value": true, "value_type": { "type": "Number" } }] }, { "name": "view", "description": "View merge request", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.merge_request" } } }] }, { "name": "checkout", "description": "Checkout merge request", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.merge_request" } } }] }, { "name": "merge", "description": "Merge a merge request", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.merge_request" } } }] }, { "name": "close", "description": "Close a merge request", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.merge_request" } } }] }, { "name": "create", "description": "Create merge request" }] },
    { "name": "issue", "description": "Manage issues", "subcommands": [{ "name": "list", "description": "List issues" }, { "name": "view", "description": "View issue", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.issue" } } }] }, { "name": "close", "description": "Close issue", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.issue" } } }] }, { "name": "reopen", "description": "Reopen issue", "arguments": [{ "name": "iid", "type": { "type": "Dynamic", "data": { "provider": "glab.issue" } } }] }, { "name": "create", "description": "Create issue" }] },
    { "name": "ci", "description": "Manage CI pipelines", "subcommands": [{ "name": "list", "description": "List pipelines" }, { "name": "view", "description": "View pipeline", "arguments": [{ "name": "pipeline_id", "type": { "type": "Dynamic", "data": { "provider": "glab.pipeline" } } }] }, { "name": "retry", "description": "Retry pipeline", "arguments": [{ "name": "pipeline_id", "type": { "type": "Dynamic", "data": { "provider": "glab.pipeline" } } }] }, { "name": "cancel", "description": "Cancel pipeline", "arguments": [{ "name": "pipeline_id", "type": { "type": "Dynamic", "data": { "provider": "glab.pipeline" } } }] }] },
    { "name": "release", "description": "Manage releases" }
  ]
}
