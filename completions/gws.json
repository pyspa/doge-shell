{
  "command": "gws",
  "description": "Google Workspace CLI",
  "global_options": [
    {
      "long": "--help",
      "description": "Show help",
      "short": "-h"
    },
    {
      "long": "--params",
      "description": "Query parameters as JSON",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--json",
      "description": "Request body as JSON",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--upload",
      "description": "Upload local media",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": null
        }
      }
    },
    {
      "long": "--upload-content-type",
      "description": "Upload MIME type",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--output",
      "description": "Save binary response",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": null
        }
      }
    },
    {
      "long": "--format",
      "description": "Output format",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "json",
          "table",
          "yaml",
          "csv"
        ]
      }
    },
    {
      "long": "--api-version",
      "description": "API version",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--page-all",
      "description": "Fetch all pages"
    },
    {
      "long": "--page-limit",
      "description": "Maximum pages",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "long": "--page-delay",
      "description": "Delay between pages in milliseconds",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    }
  ],
