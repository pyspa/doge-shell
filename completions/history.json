{
  "command": "history",
  "description": "Search and filter command history",
  "global_options": [
    {
      "short": "-q",
      "long": "--query",
      "description": "Match command text explicitly",
      "takes_value": true
    },
    {
      "short": "-s",
      "long": "--scope",
      "description": "Restrict search scope",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "global",
          "session",
          "cwd",
          "project"
        ]
      }
    },
    {
      "long": "--status",
      "description": "Filter by exit status",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "any",
          "success",
          "failure"
        ]
      }
    },
    {
      "long": "--slow",
      "description": "Show commands with duration >= ms",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-n",
      "long": "--limit",
      "description": "Limit result count (default: 200)",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Show timestamp, status, duration, and cwd"
    },
    {
      "long": "--author",
      "description": "Filter by who ran the command",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": [
          "human",
          "dsh-ai",
          "agent",
          "all"
        ]
      }
    },
    {
      "long": "--json",
      "description": "Emit one JSON value without decoration"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show this help message"
    }
  ],
  "subcommands": [
    {
      "name": "record",
      "description": "Append an externally captured command event",
      "options": [
        {
          "long": "--json",
          "description": "The event as a single JSON payload",
          "takes_value": true
        }
      ]
    }
  ]
}
