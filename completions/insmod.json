{
  "command": "insmod",
  "description": "Insert a module into the Linux kernel",
  "global_options": [
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "module_file",
      "description": "Kernel module object file",
      "type": {
        "type": "File",
        "data": {
          "extensions": ["ko", "zst", "xz", "gz"]
        }
      }
    },
    {
      "name": "params",
      "description": "Module parameters",
      "required": false,
      "multiple": true
    }
  ]
}
