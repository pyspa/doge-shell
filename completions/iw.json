{
  "command": "iw",
  "description": "nl80211 based CLI configuration utility for wireless devices",
  "subcommands": [
    { "name": "list", "description": "List wireless capabilities" },
    { "name": "event", "description": "Monitor wireless events", "options": [{ "short": "-f", "description": "Print frame contents" }, { "short": "-t", "description": "Print timestamps" }] },
    {
      "name": "dev",
      "description": "Manage wireless interfaces",
      "arguments": [
        {
          "name": "interface",
          "description": "Wireless interface",
          "required": false,
          "type": { "type": "Dynamic", "data": { "provider": "wireless.device" } }
        }
      ],
      "subcommands": [
        { "name": "info", "description": "Show interface information" },
        { "name": "link", "description": "Show link status" },
        { "name": "scan", "description": "Scan for networks" },
        { "name": "station", "description": "Station operations", "subcommands": [{ "name": "dump", "description": "Show station statistics" }, { "name": "get", "description": "Show a station" }] },
        { "name": "survey", "description": "Show channel survey data", "subcommands": [{ "name": "dump", "description": "Dump survey data" }] },
        { "name": "set", "description": "Set interface parameters" },
        { "name": "get", "description": "Get interface parameters" },
        { "name": "del", "description": "Delete the interface" },
        { "name": "interface", "description": "Interface management", "subcommands": [{ "name": "add", "description": "Add a virtual interface" }] }
      ]
    },
    {
      "name": "phy",
      "description": "Manage physical wireless devices",
      "arguments": [{ "name": "phy", "description": "PHY name", "type": { "type": "String" } }]
    },
    {
      "name": "reg",
      "description": "Regulatory domain operations",
      "subcommands": [{ "name": "get", "description": "Show regulatory domain" }, { "name": "set", "description": "Set regulatory domain", "arguments": [{ "name": "country", "description": "ISO country code", "type": { "type": "String" } }] }]
    }
  ]
}
