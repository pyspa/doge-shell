{
  "command": "meson",
  "description": "Meson build system",
  "global_options": [
    {
      "short": "-v",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "subcommands": [
    {
      "name": "setup",
      "description": "Configure a build directory",
      "options": [
        {
          "long": "--prefix",
          "description": "Installation prefix",
          "takes_value": true,
          "value_type": {
            "type": "Directory"
          }
        },
        {
          "long": "--buildtype",
          "description": "Build type",
          "takes_value": true,
          "value_type": {
            "type": "Choice",
            "data": [
              "plain",
              "debug",
              "debugoptimized",
              "release",
              "minsize",
              "custom"
            ]
          }
        }
      ],
      "arguments": [
        {
          "name": "builddir",
          "type": {
            "type": "Directory"
          }
        },
        {
          "name": "sourcedir",
          "required": false,
          "type": {
            "type": "Directory"
          }
        }
      ]
    },
    {
      "name": "compile",
      "description": "Build targets",
      "options": [
        {
          "short": "-C",
          "description": "Build directory",
          "takes_value": true,
          "value_type": {
            "type": "Directory"
          }
        },
        {
          "long": "--clean",
          "description": "Clean targets"
        },
        {
          "short": "-j",
          "long": "--jobs",
          "description": "Parallel jobs",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        }
      ],
      "arguments": [
        {
          "name": "target",
          "required": false,
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "meson.target"
            }
          }
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "options": [
        {
          "short": "-C",
          "description": "Build directory",
          "takes_value": true,
          "value_type": {
            "type": "Directory"
          }
        },
        {
          "long": "--suite",
          "description": "Test suite",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        }
      ],
      "arguments": [
        {
          "name": "test",
          "required": false,
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "meson.target"
            }
          }
        }
      ]
    },
    {
      "name": "install",
      "description": "Install project",
      "options": [
        {
          "short": "-C",
          "description": "Build directory",
          "takes_value": true,
          "value_type": {
            "type": "Directory"
          }
        },
        {
          "long": "--destdir",
          "description": "Destination root",
          "takes_value": true,
          "value_type": {
            "type": "Directory"
          }
        }
      ]
    },
    {
      "name": "configure",
      "description": "Configure project",
      "arguments": [
        {
          "name": "builddir",
          "required": false,
          "type": {
            "type": "Directory"
          }
        }
      ]
    },
    {
      "name": "introspect",
      "description": "Inspect project",
      "options": [
        {
          "long": "--targets",
          "description": "List targets"
        },
        {
          "long": "--tests",
          "description": "List tests"
        }
      ],
      "arguments": [
        {
          "name": "builddir",
          "required": false,
          "type": {
            "type": "Directory"
          }
        }
      ]
    },
    {
      "name": "subprojects",
      "description": "Manage subprojects"
    },
    {
      "name": "rewrite",
      "description": "Modify Meson build definitions"
    }
  ]
}
