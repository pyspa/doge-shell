{
  "command": "mise",
  "description": "Development tool version and task manager",
  "global_options": [
    {
      "short": "-C",
      "long": "--cd",
      "description": "Change directory before running",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Increase verbosity"
    },
    {
      "short": "-q",
      "long": "--quiet",
      "description": "Decrease verbosity"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "long": "--env",
      "description": "Load named config environments",
      "short": "-E",
      "takes_value": true,
      "value_type": {
        "type": "String"
      },
      "multiple": true
    },
    {
      "long": "--jobs",
      "description": "Parallel jobs",
      "short": "-j",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "long": "--yes",
      "description": "Accept confirmation prompts",
      "short": "-y"
    },
    {
      "long": "--raw",
      "description": "Connect directly to terminal"
    },
    {
      "long": "--locked",
      "description": "Require locked download URLs"
    },
    {
      "long": "--silent",
      "description": "Suppress task output"
    },
    {
      "long": "--version",
      "description": "Show mise version",
      "short": "-V"
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install tool versions",
      "options": [
        {
          "short": "-f",
          "long": "--force",
          "description": "Force reinstall even if already installed"
        },
        {
          "short": "-j",
          "long": "--jobs",
          "description": "Number of parallel jobs",
          "takes_value": true,
          "value_type": {
            "type": "Number"
          }
        }
      ],
      "arguments": [
        {
          "name": "tool",
          "description": "Tool@version spec",
          "multiple": true,
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "mise.registry_tool"
            }
          }
        }
      ]
    },
    {
      "name": "use",
      "description": "Use tool version in config",
      "options": [
        {
          "short": "-g",
          "long": "--global",
          "description": "Write to the global config"
        },
        {
          "long": "--pin",
          "description": "Pin the exact version"
        },
        {
          "long": "--remove",
          "description": "Remove the tool from the config",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "mise.tool"
            }
          }
        }
      ],
      "arguments": [
        {
          "name": "tool",
          "description": "Tool@version spec",
