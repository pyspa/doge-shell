{
  "command": "mongo",
  "description": "Legacy MongoDB shell",
  "global_options": [
    { "long": "--host", "description": "Server host", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--port", "description": "Server port", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-u", "long": "--username", "description": "Username", "takes_value": true, "value_type": { "type": "User" } },
    { "short": "-p", "long": "--password", "description": "Password", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--authenticationDatabase", "description": "Authentication database", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--eval", "description": "Evaluate JavaScript", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--quiet", "description": "Suppress connection messages" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [{ "name": "connection-string", "description": "MongoDB URI or database" }]
}
