{
  "command": "mysqladmin",
  "description": "MySQL administration client",
  "global_options": [
    { "short": "-h", "long": "--host", "description": "Server host", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-P", "long": "--port", "description": "Server port", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-u", "long": "--user", "description": "User", "takes_value": true, "value_type": { "type": "User" } },
    { "short": "-p", "long": "--password", "description": "Prompt for password" },
    { "short": "-?", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "status", "description": "Show status" },
    { "name": "processlist", "description": "Show process list" },
    { "name": "ping", "description": "Check server" },
    { "name": "variables", "description": "Show variables" },
    { "name": "create", "description": "Create database", "arguments": [{ "name": "database" }] },
    { "name": "drop", "description": "Drop database", "arguments": [{ "name": "database" }] },
    { "name": "shutdown", "description": "Shut down server" },
    { "name": "flush-hosts", "description": "Flush hosts" },
    { "name": "flush-logs", "description": "Flush logs" }
  ]
}
