{
  "command": "netlify",
  "description": "Netlify CLI",
  "global_options": [
    { "short": "-s", "long": "--site", "description": "Site ID", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-a", "long": "--auth", "description": "Auth token", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--json", "description": "JSON output" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "deploy", "description": "Deploy site", "options": [{ "long": "--prod", "description": "Production deploy" }, { "short": "-d", "long": "--dir", "description": "Publish directory", "takes_value": true, "value_type": { "type": "Directory" } }] },
    { "name": "dev", "description": "Start local dev server" },
    { "name": "build", "description": "Build site" },
    { "name": "init", "description": "Initialize site" },
    { "name": "link", "description": "Link site" },
    { "name": "env", "description": "Manage environment variables" },
    { "name": "functions", "description": "Manage functions" },
    { "name": "sites", "description": "Manage sites" }
  ]
}
