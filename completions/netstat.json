{
  "command": "netstat",
  "description": "Print network connections, routing tables, interface statistics, masquerade connections, and multicast memberships",
  "global_options": [
    {
      "short": "-a",
      "long": "--all",
      "description": "Show both listening and non-listening sockets"
    },
    {
      "short": "-n",
      "long": "--numeric",
      "description": "Show numerical addresses instead of trying to determine symbolic host, port or user names"
    },
    {
      "short": "-p",
      "long": "--program",
      "description": "Show the PID and name of the program to which each socket belongs"
    },
    {
      "short": "-l",
      "long": "--listening",
      "description": "Show only listening sockets"
    },
    {
      "short": "-t",
      "long": "--tcp",
      "description": "Show TCP connections"
    },
    {
      "short": "-u",
      "long": "--udp",
      "description": "Show UDP connections"
    },
    {
      "short": "-r",
      "long": "--route",
      "description": "Display the kernel routing tables"
    },
    {
      "short": "-i",
      "long": "--interfaces",
      "description": "Show a network interface table"
    },
    {
      "short": "-I",
      "description": "Show the table for one interface",
      "takes_value": true,
      "value_type": {
        "type": "Interface"
      }
    },
    {
      "short": "-s",
      "long": "--statistics",
      "description": "Show per-protocol statistics"
    },
    {
      "short": "-c",
      "long": "--continuous",
      "description": "Refresh the listing every second"
    },
    {
      "short": "-e",
      "long": "--extend",
      "description": "Show additional information"
    },
    {
      "short": "-g",
      "long": "--groups",
      "description": "Show multicast group membership"
    },
    {
      "short": "-W",
      "long": "--wide",
      "description": "Do not truncate IP addresses"
    }
  ]
}
