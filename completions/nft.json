{
  "command": "nft",
  "description": "Administration tool for nftables",
  "global_options": [
    {
      "description": "File to read commands from",
      "short": "-f",
      "long": "--file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "description": "Check commands without applying",
      "short": "-c",
      "long": "--check"
    },
    {
      "description": "Numeric output",
      "short": "-n",
      "long": "--numeric"
    },
    {
      "description": "JSON output",
      "short": "-j",
      "long": "--json"
    }
  ],
  "subcommands": [
    {
      "name": "list",
      "description": "List nftables objects",
      "subcommands": [
        { "name": "tables", "description": "List tables" },
        { "name": "ruleset", "description": "List ruleset" },
        {
          "name": "table",
          "description": "List table",
          "arguments": [
            { "name": "family", "description": "Address family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } },
            { "name": "table", "description": "Table name", "type": { "type": "Dynamic", "data": { "provider": "nft.table" } } }
          ]
        },
        {
          "name": "chain",
          "description": "List chain",
          "arguments": [
            { "name": "family", "description": "Address family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } },
            { "name": "table", "description": "Table name", "type": { "type": "Dynamic", "data": { "provider": "nft.table" } } },
            { "name": "chain", "description": "Chain name", "type": { "type": "Dynamic", "data": { "provider": "nft.chain" } } }
          ]
        }
      ]
    },
    {
      "name": "add",
      "description": "Add nftables object",
      "subcommands": [
        { "name": "table", "description": "Add table", "arguments": [{ "name": "family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } }, { "name": "table" }] },
        { "name": "chain", "description": "Add chain", "arguments": [{ "name": "family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } }, { "name": "table", "type": { "type": "Dynamic", "data": { "provider": "nft.table" } } }, { "name": "chain" }] }
      ]
    },
    {
      "name": "delete",
      "description": "Delete nftables object",
      "subcommands": [
        { "name": "table", "description": "Delete table", "arguments": [{ "name": "family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } }, { "name": "table", "type": { "type": "Dynamic", "data": { "provider": "nft.table" } } }] },
        { "name": "chain", "description": "Delete chain", "arguments": [{ "name": "family", "type": { "type": "Choice", "data": ["ip", "ip6", "inet", "arp", "bridge", "netdev"] } }, { "name": "table", "type": { "type": "Dynamic", "data": { "provider": "nft.table" } } }, { "name": "chain", "type": { "type": "Dynamic", "data": { "provider": "nft.chain" } } }] }
      ]
    },
    { "name": "flush", "description": "Flush nftables objects" },
    { "name": "monitor", "description": "Monitor nftables events" }
  ]
}
