{
  "command": "nomad",
  "description": "Nomad workload orchestrator CLI",
  "global_options": [
    { "long": "--address", "description": "Nomad server address", "takes_value": true, "value_type": { "type": "Url" } },
    { "long": "--region", "description": "Nomad region", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--namespace", "description": "Nomad namespace", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "nomad.namespace" } } },
    { "long": "--token", "description": "ACL token", "takes_value": true, "value_type": { "type": "String" } }
  ],
  "subcommands": [
    { "name": "agent", "description": "Run a Nomad agent", "options": [{ "long": "--config", "description": "Configuration file or directory", "takes_value": true, "value_type": { "type": "File", "data": {} } }, { "long": "--dev", "description": "Run a development agent" }] },
    { "name": "job", "description": "Manage jobs", "subcommands": [{ "name": "run", "description": "Run a job", "arguments": [{ "name": "jobfile", "description": "Job specification", "type": { "type": "File", "data": { "extensions": ["hcl", "json"] } } }] }, { "name": "plan", "description": "Plan a job" }, { "name": "status", "description": "Show job status", "arguments": [{ "name": "job", "type": { "type": "Dynamic", "data": { "provider": "nomad.job" } } }] }, { "name": "stop", "description": "Stop a job", "arguments": [{ "name": "job", "type": { "type": "Dynamic", "data": { "provider": "nomad.job" } } }] }, { "name": "restart", "description": "Restart allocations", "arguments": [{ "name": "job", "type": { "type": "Dynamic", "data": { "provider": "nomad.job" } } }] }, { "name": "history", "description": "Show job history", "arguments": [{ "name": "job", "type": { "type": "Dynamic", "data": { "provider": "nomad.job" } } }] }, { "name": "inspect", "description": "Inspect a job", "arguments": [{ "name": "job", "type": { "type": "Dynamic", "data": { "provider": "nomad.job" } } }] }] },
    { "name": "alloc", "description": "Manage allocations", "subcommands": [{ "name": "status", "description": "Show allocation status", "arguments": [{ "name": "allocation", "type": { "type": "Dynamic", "data": { "provider": "nomad.allocation" } } }] }, { "name": "logs", "description": "Show allocation logs", "arguments": [{ "name": "allocation", "type": { "type": "Dynamic", "data": { "provider": "nomad.allocation" } } }] }, { "name": "exec", "description": "Execute a command in an allocation", "arguments": [{ "name": "allocation", "type": { "type": "Dynamic", "data": { "provider": "nomad.allocation" } } }] }, { "name": "stop", "description": "Stop an allocation", "arguments": [{ "name": "allocation", "type": { "type": "Dynamic", "data": { "provider": "nomad.allocation" } } }] }] },
    { "name": "node", "description": "Manage client nodes", "subcommands": [{ "name": "status", "description": "Show node status", "arguments": [{ "name": "node", "type": { "type": "Dynamic", "data": { "provider": "nomad.node" } } }] }, { "name": "drain", "description": "Manage node drain", "arguments": [{ "name": "node", "type": { "type": "Dynamic", "data": { "provider": "nomad.node" } } }] }, { "name": "eligibility", "description": "Set node eligibility", "arguments": [{ "name": "node", "type": { "type": "Dynamic", "data": { "provider": "nomad.node" } } }] }] },
    { "name": "server", "description": "Manage server members" },
    { "name": "deployment", "description": "Manage deployments" },
    { "name": "namespace", "description": "Manage namespaces", "subcommands": [{ "name": "list", "description": "List namespaces" }, { "name": "inspect", "description": "Inspect namespace", "arguments": [{ "name": "namespace", "type": { "type": "Dynamic", "data": { "provider": "nomad.namespace" } } }] }, { "name": "delete", "description": "Delete namespace", "arguments": [{ "name": "namespace", "type": { "type": "Dynamic", "data": { "provider": "nomad.namespace" } } }] }] },
    { "name": "volume", "description": "Manage volumes", "subcommands": [{ "name": "status", "description": "Show volume status", "arguments": [{ "name": "volume", "type": { "type": "Dynamic", "data": { "provider": "nomad.volume" } } }] }, { "name": "deregister", "description": "Deregister a volume", "arguments": [{ "name": "volume", "type": { "type": "Dynamic", "data": { "provider": "nomad.volume" } } }] }] },
    { "name": "acl", "description": "Manage ACL policies and tokens" },
    { "name": "operator", "description": "Operator-specific commands" },
    { "name": "var", "description": "Manage variables" },
    { "name": "version", "description": "Print version information" }
  ]
}
