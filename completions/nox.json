{
  "command": "nox",
  "description": "Python automation sessions",
  "global_options": [
    { "short": "-f", "long": "--noxfile", "description": "Noxfile", "takes_value": true, "value_type": { "type": "File", "data": { "extensions": [".py"] } } },
    { "short": "-s", "long": "--session", "description": "Session to run", "takes_value": true, "multiple": true, "value_type": { "type": "Dynamic", "data": { "provider": "nox.session" } } },
    { "long": "--sessions", "description": "Sessions to run", "takes_value": true, "multiple": true, "value_type": { "type": "Dynamic", "data": { "provider": "nox.session" } } },
    { "short": "-k", "long": "--keywords", "description": "Only run sessions matching expression", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-t", "long": "--tags", "description": "Only run sessions with the given tags", "takes_value": true, "multiple": true, "value_type": { "type": "String" } },
    { "short": "-p", "long": "--pythons", "description": "Python interpreters to run sessions against", "takes_value": true, "multiple": true, "value_type": { "type": "String" } },
    { "short": "-r", "long": "--reuse-existing-virtualenvs", "description": "Reuse existing virtualenvs" },
    { "short": "-R", "long": "--reuse-existing-virtualenvs-no-install", "description": "Reuse virtualenvs and skip installs" },
    { "long": "--no-venv", "description": "Run sessions in the current environment" },
    { "long": "--force-color", "description": "Force color output" },
    { "long": "--no-color", "description": "Disable color output" },
    { "short": "-l", "long": "--list", "description": "List sessions" },
    { "long": "--list-sessions", "description": "List sessions" },
    { "long": "--json", "description": "Emit machine readable output with --list" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [
    {
      "name": "session",
      "description": "Session to run",
      "required": false,
      "multiple": true,
      "type": { "type": "Dynamic", "data": { "provider": "nox.session" } }
    }
  ]
}
