{
  "command": "npm",
  "description": "Node Package Manager",
  "global_options": [
    {
      "long": "--version",
      "short": "-v",
      "description": "Print version information"
    },
    {
      "long": "--help",
      "short": "-h",
      "description": "Print help information"
    },
    {
      "long": "--verbose",
      "description": "Increase verbosity"
    },
    {
      "long": "--silent",
      "description": "Suppress output"
    },
    {
      "long": "--loglevel",
      "description": "Level of logging (silent, error, warn, info, verbose)"
    },
    {
      "long": "--workspace",
      "short": "-w",
      "description": "Run command in a workspace",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "node.workspace" } }
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install package(s)",
      "options": [
        {
          "long": "--save",
          "short": "-S",
          "description": "Package will appear in dependencies"
        },
        {
          "long": "--save-dev",
          "short": "-D",
          "description": "Package will appear in devDependencies"
        },
        {
          "long": "--save-optional",
          "short": "-O",
          "description": "Package will appear in optionalDependencies"
        },
        {
          "long": "--global",
          "short": "-g",
          "description": "Install globally"
        },
        {
          "long": "--save-exact",
          "short": "-E",
          "description": "Saved dependencies will be configured with exact version"
        },
        {
          "long": "--production",
          "description": "Skip devDependencies"
        },
        {
          "long": "--only",
          "description": "Only install type (prod, dev)"
        },
        {
          "long": "--no-save",
          "description": "Prevents saving to dependencies"
        },
        {
          "long": "--package-lock-only",
          "description": "Only update the package-lock.json"
        },
        {
          "long": "--force",
          "short": "-f",
          "description": "Forces npm to fetch remote resources even if a local copy exists on disk"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "description": "Package name or path (optional)"
        }
      ],
      "subcommands": []
    },
    {
      "name": "run",
      "description": "Run arbitrary package scripts",
      "options": [
        {
          "long": "--silent",
          "description": "Do not output JSON data to stdout"
        },
        {
          "long": "--if-present",
          "description": "Run if script present"
        }
      ],
      "arguments": [
        {
          "name": "script",
          "description": "Script name from package.json",
          "type": { "type": "Dynamic", "data": { "provider": "project.task", "scope": "npm" } }
        }
      ],
      "subcommands": []
    },
    {
      "name": "start",
      "description": "Start script from package.json (alias for run start)",
      "options": [
        {
          "long": "--silent",
          "description": "Do not output JSON data to stdout"
        }
      ],
      "arguments": [
        {
          "name": "args",
          "description": "Arguments to pass to start script"
        }
      ],
      "subcommands": []
    },
    {
      "name": "build",
      "description": "Build script from package.json (alias for run build)",
      "options": [
        {
          "long": "--silent",
          "description": "Do not output JSON data to stdout"
        }
      ],
      "arguments": [
        {
          "name": "args",
          "description": "Arguments to pass to build script"
        }
      ],
      "subcommands": []
    },
    {
      "name": "test",
      "description": "Test script from package.json (alias for run test)",
      "options": [
        {
          "long": "--silent",
          "description": "Do not output JSON data to stdout"
        },
        {
          "long": "--if-present",
          "description": "Run if script present"
        }
      ],
      "arguments": [
        {
          "name": "args",
          "description": "Arguments to pass to test script"
        }
      ],
      "subcommands": []
    },
    {
      "name": "init",
      "description": "Create package.json",
      "options": [
        {
          "long": "--yes",
          "short": "-y",
          "description": "Answer yes to all prompts"
        },
        {
          "long": "--force",
          "short": "-f",
          "description": "Force overwrite package.json"
        },
        {
          "long": "--scope",
          "description": "Scope for the package"
        },
        {
          "long": "--description",
          "description": "Package description"
        }
      ],
      "arguments": [],
      "subcommands": []
    },
    {
      "name": "exec",
      "description": "Execute a package binary",
      "options": [
        { "long": "--package", "description": "Package to install for execution", "takes_value": true, "value_type": { "type": "String" } },
        { "short": "-c", "long": "--call", "description": "Command string to execute", "takes_value": true, "value_type": { "type": "String" } }
      ],
      "arguments": [
        {
          "name": "binary",
          "description": "Local package binary",
          "type": { "type": "Dynamic", "data": { "provider": "node.bin" } }
        }
      ],
      "subcommands": []
    },
    {
      "name": "ci",
      "description": "Clean install from package lock",
      "options": [
        { "long": "--omit", "description": "Dependency types to omit", "takes_value": true, "value_type": { "type": "Choice", "data": ["dev", "optional", "peer"] } },
        { "long": "--ignore-scripts", "description": "Do not run lifecycle scripts" }
      ],
      "arguments": [],
      "subcommands": []
    },
    {
      "name": "uninstall",
      "description": "Remove a package",
      "options": [
        {
          "long": "--save",
          "short": "-S",
          "description": "Remove from dependencies"
        },
        {
          "long": "--save-dev",
          "short": "-D",
          "description": "Remove from devDependencies"
        },
        {
          "long": "--global",
          "short": "-g",
          "description": "Remove globally"
        },
        {
          "long": "--no-save",
          "description": "Prevents removing from dependencies"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "description": "Package name(s)",
          "type": {
            "type": "Dynamic",
            "data": { "provider": "js.dependency" }
          }
        }
      ],
      "subcommands": []
    },
    {
      "name": "update",
      "description": "Update outdated packages",
      "options": [
        {
          "long": "--global",
          "short": "-g",
          "description": "Update globally"
        },
        {
          "long": "--depth",
          "description": "Max depth of dependency tree"
        },
        {
          "long": "--save",
          "short": "-S",
          "description": "Update dependencies in package.json"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "description": "Specific package (optional)",
          "type": {
            "type": "Dynamic",
            "data": { "provider": "js.dependency" }
          }
        }
      ],
      "subcommands": []
    },
    {
      "name": "publish",
      "description": "Publish a package to the registry",
      "options": [
        { "long": "--access", "description": "Set access level", "takes_value": true, "value_type": { "type": "Choice", "data": ["public", "restricted"] } },
        { "long": "--tag", "description": "Register the published package with the given tag", "takes_value": true, "value_type": { "type": "String" } },
        { "long": "--dry-run", "description": "Report what would have been published" },
        { "long": "--otp", "description": "One-time password for 2FA", "takes_value": true, "value_type": { "type": "String" } },
        { "long": "--registry", "description": "Registry URL", "takes_value": true, "value_type": { "type": "Url" } }
      ]
    },
    {
      "name": "link",
      "description": "Symlink a package folder",
      "arguments": [
        { "name": "package", "description": "Package to link (optional)", "required": false }
      ]
    },
    {
      "name": "outdated",
      "description": "Check for outdated packages",
      "options": [
        { "long": "--global", "short": "-g", "description": "Check global packages" },
        { "long": "--json", "description": "Output in JSON format" },
        { "long": "--long", "short": "-l", "description": "Show extended information" }
      ],
      "arguments": [
        { "name": "package", "description": "Specific package (optional)", "type": { "type": "Dynamic", "data": { "provider": "js.dependency" } } }
      ]
    },
    {
      "name": "ls",
      "description": "List installed packages",
      "options": [
        { "long": "--global", "short": "-g", "description": "List global packages" },
        { "long": "--depth", "description": "Max depth of dependency tree", "takes_value": true, "value_type": { "type": "Number" } },
        { "long": "--json", "description": "Output in JSON format" },
        { "long": "--long", "short": "-l", "description": "Show extended information" }
      ]
    },
    {
      "name": "view",
      "description": "View registry info",
      "arguments": [
        { "name": "package", "description": "Package[@version]" }
      ]
    },
    {
      "name": "config",
      "description": "Manage the npm configuration",
      "subcommands": [
        { "name": "set", "description": "Set a config value" },
        { "name": "get", "description": "Get a config value" },
        { "name": "list", "description": "List all config settings" },
        { "name": "delete", "description": "Delete a config value" }
      ]
    },
    {
      "name": "cache",
      "description": "Manipulates packages cache",
      "subcommands": [
        { "name": "add", "description": "Add the specified packages to the local cache" },
        { "name": "verify", "description": "Verify the contents of the cache folder" },
        { "name": "clean", "description": "Delete all data out of the cache folder" }
      ]
    },
    {
      "name": "login",
      "description": "Log in to the registry"
    },
    {
      "name": "logout",
      "description": "Log out of the registry"
    },
    {
      "name": "search",
      "description": "Search for packages",
      "arguments": [
        { "name": "terms", "description": "Search terms", "multiple": true }
      ]
    },
    {
      "name": "token",
      "description": "Manage your authentication tokens",
      "subcommands": [
        { "name": "list", "description": "Show a list of active authentication tokens" },
        { "name": "create", "description": "Create a new authentication token" },
        { "name": "revoke", "description": "Revoke an authentication token" }
      ]
    },
    {
      "name": "dedupe",
      "description": "Reduce duplication in the package tree"
    },
    {
      "name": "pkg",
      "description": "Manipulate your package.json",
      "arguments": [
        { "name": "command", "description": "get|set|delete to modify a field" }
      ]
    },
    {
      "name": "docs",
      "description": "Open documentation for a package",
      "arguments": [
        { "name": "package", "description": "Package to open docs for", "required": false }
      ]
    },
    {
      "name": "explain",
      "description": "Explain installed packages",
      "arguments": [
        { "name": "package", "description": "Package specifier", "multiple": true }
      ]
    },
    {
      "name": "prune",
      "description": "Remove extraneous packages",
      "options": [
        { "long": "--dry-run", "description": "Report what would be removed without removing" }
      ]
    },
    {
      "name": "ping",
      "description": "Ping the npm registry"
    },
    {
      "name": "prefix",
      "description": "Display npm prefix",
      "options": [
        { "long": "--global", "short": "-g", "description": "Print the global prefix" }
      ]
    },
    {
      "name": "root",
      "description": "Display npm root",
      "options": [
        { "long": "--global", "short": "-g", "description": "Print the global root" }
      ]
    },
    {
      "name": "version",
      "description": "Bump a package version",
      "arguments": [
        { "name": "newversion", "description": "New version or increment type", "required": false, "type": { "type": "Choice", "data": ["major", "minor", "patch", "premajor", "preminor", "prepatch", "prerelease"] } }
      ]
    },
    {
      "name": "whoami",
      "description": "Display registry username"
    },
    {
      "name": "pack",
      "description": "Create a tarball from a package",
      "options": [
        { "long": "--dry-run", "description": "Report what would be packed without packing" }
      ]
    },
    {
      "name": "dist-tag",
      "description": "Modify package distribution tags",
      "subcommands": [
        { "name": "add", "description": "Add a tag to a package version" },
        { "name": "rm", "description": "Remove a tag from a package" },
        { "name": "ls", "description": "List all dist-tags of a package" }
      ]
    },
    {
      "name": "org",
      "description": "Manage orgs and org members",
      "subcommands": [
        { "name": "add", "description": "Add a user to an org" },
        { "name": "rm", "description": "Remove a user from an org" },
        { "name": "ls", "description": "List users in an org" }
      ]
    },
    {
      "name": "team",
      "description": "Manage organization teams and team memberships",
      "subcommands": [
        { "name": "create", "description": "Create a team" },
        { "name": "destroy", "description": "Destroy a team" },
        { "name": "add", "description": "Add a user to a team" },
        { "name": "rm", "description": "Remove a user from a team" },
        { "name": "ls", "description": "List teams or team members" }
      ]
    }
  ]
}
