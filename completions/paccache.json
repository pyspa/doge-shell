{
  "command": "paccache",
  "description": "Clean the pacman package cache",
  "global_options": [
    {
      "short": "-k",
      "long": "--keep",
      "description": "Keep this many versions",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-r",
      "long": "--remove",
      "description": "Remove candidate packages"
    },
    {
      "short": "-u",
      "long": "--uninstalled",
      "description": "Target uninstalled packages"
    },
    {
      "short": "-c",
      "long": "--cachedir",
      "description": "Package cache directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-d",
      "long": "--dryrun",
      "description": "Perform a dry run"
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    }
  ]
}
