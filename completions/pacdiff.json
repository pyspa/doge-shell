{
  "command": "pacdiff",
  "description": "Manage pacnew and pacsave files",
  "global_options": [
    {
      "short": "-o",
      "long": "--output",
      "description": "Print files instead of merging"
    },
    {
      "short": "-f",
      "long": "--find",
      "description": "Scan filesystem"
    },
    {
      "short": "-l",
      "long": "--locate",
      "description": "Use locate database"
    },
    {
      "short": "-p",
      "long": "--pacmandb",
      "description": "Use pacman database"
    },
    {
      "short": "-s",
      "long": "--sudo",
      "description": "Sudo command",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-3",
      "long": "--threeway",
      "description": "View three-way merge"
    }
  ]
}
