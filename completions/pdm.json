{
  "command": "pdm",
  "description": "Python package and dependency manager",
  "global_options": [
    {
      "short": "-p",
      "long": "--project",
      "description": "Project directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-g",
      "long": "--global",
      "description": "Use global project"
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a project script",
      "arguments": [
        {
          "name": "script",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "pdm.script"
            }
          }
        },
        {
          "name": "argument",
          "required": false,
          "multiple": true,
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "add",
      "description": "Add dependencies",
      "options": [
        {
          "short": "-d",
          "long": "--dev",
          "description": "Add development dependency"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "multiple": true,
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove dependencies",
      "arguments": [
        {
          "name": "package",
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "python.project_dependency"
            }
          }
        }
      ]
    },
    {
      "name": "update",
      "description": "Update dependencies",
      "arguments": [
        {
          "name": "package",
          "required": false,
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "python.project_dependency"
            }
          }
        }
      ]
    },
    {
      "name": "install",
      "description": "Install project dependencies"
    },
    {
      "name": "sync",
      "description": "Synchronize environment"
    },
    {
      "name": "lock",
      "description": "Resolve and lock dependencies"
    },
    {
      "name": "build",
      "description": "Build distributions"
    },
    {
      "name": "publish",
      "description": "Publish distributions"
    },
    {
      "name": "venv",
      "description": "Manage virtual environments"
    }
  ]
}
