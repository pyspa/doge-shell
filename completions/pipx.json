{
  "command": "pipx",
  "description": "Install and run Python applications in isolated environments",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" },
    { "long": "--version", "description": "Show version" },
    { "long": "--quiet", "short": "-q", "description": "Quiet output" },
    { "long": "--verbose", "description": "Verbose output" },
    {
      "long": "--python",
      "description": "Python interpreter to build the venv with",
      "takes_value": true,
      "value_type": { "type": "Command" }
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a package",
      "options": [
        { "long": "--force", "short": "-f", "description": "Reinstall even if already installed" },
        { "long": "--include-deps", "description": "Include apps of dependent packages" },
        { "long": "--editable", "short": "-e", "description": "Install in editable mode" },
        { "long": "--suffix", "description": "Suffix appended to the installed app names", "takes_value": true }
      ],
      "arguments": [{ "name": "package", "description": "Package spec", "multiple": true }]
    },
    {
      "name": "run",
      "description": "Download and run an app",
      "options": [
        { "long": "--spec", "description": "Package spec to install the app from", "takes_value": true },
        { "long": "--no-cache", "description": "Do not reuse a cached venv" }
      ],
      "arguments": [{ "name": "app", "description": "App or package spec" }]
    },
    {
      "name": "inject",
      "description": "Install packages into an existing pipx venv",
      "options": [
        { "long": "--include-apps", "description": "Expose apps from the injected packages" },
        { "long": "--force", "short": "-f", "description": "Reinstall even if already installed" }
      ],
      "arguments": [
        {
          "name": "package",
          "description": "Installed package to inject into",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        },
        { "name": "dependency", "description": "Package spec to inject", "multiple": true }
      ]
    },
    {
      "name": "uninject",
      "description": "Remove injected packages from a pipx venv",
      "arguments": [
        {
          "name": "package",
          "description": "Installed package",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        },
        { "name": "dependency", "description": "Injected package to remove", "multiple": true }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall a package",
      "arguments": [
        {
          "name": "package",
          "description": "Installed package",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        }
      ]
    },
    { "name": "uninstall-all", "description": "Uninstall all packages" },
    {
      "name": "upgrade",
      "description": "Upgrade a package",
      "options": [
        { "long": "--include-injected", "description": "Also upgrade injected packages" },
        { "long": "--force", "short": "-f", "description": "Reinstall even if already up to date" }
      ],
      "arguments": [
        {
          "name": "package",
          "description": "Installed package",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        }
      ]
    },
    { "name": "upgrade-all", "description": "Upgrade all packages" },
    {
      "name": "reinstall",
      "description": "Reinstall a package into a fresh venv",
      "arguments": [
        {
          "name": "package",
          "description": "Installed package",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        }
      ]
    },
    { "name": "reinstall-all", "description": "Reinstall every package" },
    {
      "name": "runpip",
      "description": "Run pip inside a package's venv",
      "arguments": [
        {
          "name": "package",
          "description": "Installed package",
          "type": { "type": "Dynamic", "data": { "provider": "pipx.installed_package" } }
        },
        { "name": "args", "description": "pip arguments", "multiple": true }
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        { "long": "--short", "description": "List only package names and versions" },
        { "long": "--json", "description": "JSON output" },
        { "long": "--include-injected", "description": "Include injected packages" }
      ]
    },
    { "name": "environment", "description": "Show pipx environment variables" },
    { "name": "ensurepath", "description": "Ensure pipx binary path is on PATH" }
  ]
}
