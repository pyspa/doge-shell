{
  "command": "pyright",
  "description": "Static type checker for Python",
  "global_options": [
    {
      "short": "-p",
      "long": "--project",
      "description": "Configuration file or directory",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "json"
          ]
        }
      }
    },
    {
      "long": "--pythonpath",
      "description": "Python interpreter",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "long": "--pythonversion",
      "description": "Target Python version",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--pythonplatform",
      "description": "Target platform",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--typeshedpath",
      "description": "Typeshed directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "long": "--verifytypes",
      "description": "Verify package typing",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "python.module"
        }
      }
    },
    {
      "short": "-w",
      "long": "--watch",
      "description": "Watch files"
    },
    {
      "long": "--outputjson",
      "description": "JSON output"
    }
  ],
  "arguments": [
    {
      "name": "path",
      "required": false,
      "multiple": true,
      "type": {
        "type": "File",
        "data": {
          "extensions": [
            "py"
          ]
        }
      }
    }
  ]
}
