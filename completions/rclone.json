{
  "command": "rclone",
  "description": "Cloud storage sync tool",
  "global_options": [
    { "short": "-v", "long": "--verbose", "description": "Verbose output" },
    { "short": "-n", "long": "--dry-run", "description": "Trial run without changes" },
    { "long": "--config", "description": "Config file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--transfers", "description": "Parallel transfers", "takes_value": true, "value_type": { "type": "Number" } },
    { "long": "--checkers", "description": "Parallel checkers", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "copy", "description": "Copy files", "arguments": [{ "name": "source", "type": { "type": "File", "data": {} } }, { "name": "dest" }] },
    { "name": "sync", "description": "Sync source to destination", "arguments": [{ "name": "source", "type": { "type": "File", "data": {} } }, { "name": "dest" }] },
    { "name": "move", "description": "Move files", "arguments": [{ "name": "source", "type": { "type": "File", "data": {} } }, { "name": "dest" }] },
    { "name": "ls", "description": "List objects", "arguments": [{ "name": "remote" }] },
    { "name": "lsd", "description": "List directories", "arguments": [{ "name": "remote" }] },
    { "name": "mount", "description": "Mount remote", "arguments": [{ "name": "remote" }, { "name": "mountpoint", "type": { "type": "Directory" } }] },
    { "name": "config", "description": "Manage remotes" }
  ]
}
