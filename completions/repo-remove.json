{
  "command": "repo-remove",
  "description": "Remove packages from a pacman repository database",
  "global_options": [
    {
      "short": "-s",
      "long": "--sign",
      "description": "Sign database"
    },
    {
      "short": "-k",
      "long": "--key",
      "description": "Signing key",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-v",
      "long": "--verify",
      "description": "Verify database"
    }
  ],
  "arguments": [
    {
      "name": "database",
      "type": {
        "type": "File",
        "data": {
          "extensions": [
            "db.tar.gz",
            "db.tar.xz",
            "db.tar.zst"
          ]
        }
      }
    },
    {
      "name": "package",
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "pacman.package"
        }
      }
    }
  ]
}
