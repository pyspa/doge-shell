{
  "command": "rsync",
  "description": "A fast, versatile, remote (and local) file-copying tool",
  "global_options": [
    {
      "short": "-a",
      "long": "--archive",
      "description": "Archive mode (equivalent to -rlptgoD)"
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Increase verbosity"
    },
    {
      "short": "-z",
      "long": "--compress",
      "description": "Compress file data during the transfer"
    },
    {
      "short": "-r",
      "long": "--recursive",
      "description": "Recurse into directories"
    },
    {
      "short": "-P",
      "description": "Same as --partial --progress"
    },
    {
      "long": "--delete",
      "description": "Delete extraneous files from dest dirs"
    },
    {
      "long": "--exclude",
      "description": "Exclude files matching PATTERN",
      "takes_value": true,
      "value_type": { "type": "String" }
    },
    {
      "short": "-n",
      "long": "--dry-run",
      "description": "Perform a trial run with no changes made"
    },
    {
      "short": "-e",
      "long": "--rsh",
      "description": "Specify the remote shell to use",
      "takes_value": true,
      "value_type": { "type": "Command" }
    },
    {
      "long": "--progress",
      "description": "Show progress during transfer"
    },
    {
      "long": "--partial",
      "description": "Keep partially transferred files"
    },
    {
      "long": "--include",
      "description": "Include files matching PATTERN",
      "takes_value": true,
      "value_type": { "type": "String" }
    },
    {
      "short": "-h",
      "long": "--human-readable",
      "description": "Output numbers in a human-readable format"
    },
    {
      "long": "--checksum",
      "description": "Skip based on checksum, not mod-time & size"
    },
    {
      "short": "-u",
      "long": "--update",
      "description": "Skip files that are newer on the receiver"
    },
    {
      "long": "--no-perms",
      "description": "Don't preserve permissions"
    }
  ],
  "arguments": [
    {
      "name": "source",
      "description": "Source file/dir or [user@]host:path",
      "type": { "type": "File", "data": {} }
    },
    {
      "name": "destination",
      "description": "Destination file/dir or [user@]host:path",
      "multiple": true,
      "type": { "type": "File", "data": {} }
    }
  ]
}
