{
  "command": "sccache",
  "description": "Shared compilation cache",
  "global_options": [
    {
      "short": "-s",
      "long": "--show-stats",
      "description": "Show cache statistics"
    },
    {
      "short": "-z",
      "long": "--zero-stats",
      "description": "Reset statistics"
    },
    {
      "long": "--start-server",
      "description": "Start server"
    },
    {
      "long": "--stop-server",
      "description": "Stop server"
    },
    {
      "long": "--dist-status",
      "description": "Show distributed status"
    },
    {
      "long": "--dist-auth",
      "description": "Authenticate distributed client"
    },
    {
      "long": "--package-toolchain",
      "description": "Package a toolchain",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    }
  ],
  "arguments": [
    {
      "name": "compiler",
      "required": false,
      "multiple": true,
      "type": {
        "type": "CommandWithArgs"
      }
    }
  ]
}
