{
  "command": "starship",
  "description": "Cross-shell prompt",
  "global_options": [{ "long": "--config", "description": "Configuration file", "takes_value": true, "value_type": { "type": "File", "data": { "extensions": ["toml"] } } }],
  "subcommands": [
    { "name": "init", "description": "Print shell initialization code", "arguments": [{ "name": "shell", "description": "Shell name", "type": { "type": "Choice", "data": ["bash", "elvish", "fish", "ion", "nu", "powershell", "tcsh", "xonsh", "zsh"] } }] },
    { "name": "preset", "description": "Print or apply a prompt preset", "options": [{ "short": "-o", "long": "--output", "description": "Write preset to a file", "takes_value": true, "value_type": { "type": "File", "data": {} } }] },
    { "name": "config", "description": "Edit configuration values", "arguments": [{ "name": "key", "description": "Configuration key", "required": false }, { "name": "value", "description": "Configuration value", "required": false }] },
    { "name": "explain", "description": "Explain rendered modules" },
    { "name": "module", "description": "Print a prompt module", "arguments": [{ "name": "module", "description": "Module name" }] },
    { "name": "print-config", "description": "Print the computed configuration" },
    { "name": "prompt", "description": "Print the full prompt" },
    { "name": "timings", "description": "Print module timings" },
    { "name": "toggle", "description": "Toggle a boolean configuration value" },
    { "name": "completions", "description": "Generate shell completions", "arguments": [{ "name": "shell", "description": "Shell name", "type": { "type": "Choice", "data": ["bash", "elvish", "fish", "powershell", "zsh"] } }] }
  ]
}
