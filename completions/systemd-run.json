{
  "command": "systemd-run",
  "description": "Run a command in a transient systemd unit",
  "global_options": [
    {
      "long": "--user",
      "description": "Run as user service manager"
    },
    {
      "long": "--scope",
      "description": "Run as scope unit"
    },
    {
      "long": "--unit",
      "description": "Unit name",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-p",
      "long": "--property",
      "description": "Set unit property",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--slice",
      "description": "Slice the transient unit is placed in",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "systemctl.unit",
          "scope": "slice"
        }
      }
    },
    {
      "long": "--on-calendar",
      "description": "Run as a transient timer on the given calendar event",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--timer-property",
      "description": "Set a property on the transient timer unit",
      "takes_value": true,
      "multiple": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-M",
      "long": "--machine",
      "description": "Run on a local container",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "machinectl.machine"
        }
      }
    },
    {
      "short": "-E",
      "long": "--setenv",
      "description": "Set an environment variable for the unit",
      "takes_value": true,
      "multiple": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "shell.env_var"
        }
      }
    },
    {
      "long": "--uid",
      "description": "Run under the given user",
      "takes_value": true,
      "value_type": {
        "type": "User"
      }
    },
    {
      "long": "--gid",
      "description": "Run under the given group",
      "takes_value": true,
      "value_type": {
        "type": "Group"
      }
    },
    {
      "long": "--working-directory",
      "description": "Working directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "long": "--same-dir",
      "description": "Use current working directory"
    },
    {
      "long": "--collect",
      "description": "Unload unit after it exits"
    },
    {
      "long": "--wait",
      "description": "Synchronously wait for completion"
    }
  ],
  "arguments": [
    {
      "name": "command",
      "description": "command to execute",
      "multiple": true,
      "type": {
        "type": "CommandWithArgs"
      }
    }
  ]
}
