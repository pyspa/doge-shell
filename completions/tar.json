{
  "command": "tar",
  "short_option_clusters": true,
  "description": "An archiving utility",
  "global_options": [
    {
      "short": "-c",
      "long": "--create",
      "description": "Create a new archive"
    },
    {
      "short": "-x",
      "long": "--extract",
      "description": "Extract files from an archive"
    },
    {
      "short": "-t",
      "long": "--list",
      "description": "List the contents of an archive"
    },
    {
      "short": "-v",
      "multiple": true,
      "long": "--verbose",
      "description": "Verbosely list files processed"
    },
    {
      "short": "-f",
      "long": "--file",
      "description": "Use archive file or device ARCHIVE",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-z",
      "long": "--gzip",
      "description": "Filter the archive through gzip"
    },
    {
      "short": "-j",
      "long": "--bzip2",
      "description": "Filter the archive through bzip2"
    },
    {
      "short": "-J",
      "long": "--xz",
      "description": "Filter the archive through xz"
    },
    {
      "short": "-C",
      "multiple": true,
      "long": "--directory",
      "description": "Change to directory DIR",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "long": "--exclude",
      "multiple": true,
      "description": "Exclude files, given as a PATTERN",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-P",
      "description": "Preserve absolute pathnames"
    },
    {
      "short": "-S",
      "long": "--sparse",
      "description": "Handle sparse files"
    },
    {
      "short": "-w",
      "long": "--interactive",
      "description": "Ask for confirmation before each action"
    },
    {
      "short": "-T",
      "long": "--files-from",
      "description": "Read member names from a file",
      "takes_value": true,
      "multiple": true,
      "value_type": { "type": "File", "data": {} }
    },
    {
      "short": "-X",
      "long": "--exclude-from",
      "description": "Read exclusion patterns from a file",
      "takes_value": true,
      "multiple": true,
      "value_type": { "type": "File", "data": {} }
    },
    {
      "short": "-h",
      "long": "--dereference",
      "description": "Follow symlinks; archive and dump the files they point to"
    }
  ],
  "arguments": [
    {
      "name": "file_or_member",
      "description": "Local file or archive member",
      "multiple": true,
      "type": { "type": "Dynamic", "data": { "provider": "archive.entry" } }
    }
  ],
  "subcommands": []
}
