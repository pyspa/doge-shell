{
  "command": "terraform",
  "description": "Infrastructure as code CLI",
  "global_options": [
    { "short": "-chdir", "description": "Switch to a different working directory", "takes_value": true, "value_type": { "type": "Directory" } },
    { "long": "--help", "description": "Show help" },
    { "long": "--version", "description": "Show version" }
  ],
  "subcommands": [
    { "name": "init", "description": "Prepare working directory" },
    {
      "name": "plan",
      "description": "Show execution plan",
      "options": [
        { "short": "-out", "description": "Write plan to file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
        { "short": "-var-file", "description": "Load variable file", "takes_value": true, "value_type": { "type": "File", "data": { "extensions": ["tfvars"] } } },
        { "short": "-target", "description": "Resource address to target", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } },
        { "short": "-destroy", "description": "Create destroy plan" }
      ]
    },
    {
      "name": "apply",
      "description": "Apply changes",
      "options": [{ "short": "-target", "description": "Resource address to target", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }],
      "arguments": [{ "name": "plan", "description": "Saved plan file", "required": false, "type": { "type": "File", "data": {} } }]
    },
    { "name": "destroy", "description": "Destroy managed infrastructure", "options": [{ "short": "-target", "description": "Resource address to target", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }] },
    { "name": "import", "description": "Import existing infrastructure", "arguments": [{ "name": "address", "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }, { "name": "id", "type": { "type": "String" } }] },
    { "name": "state", "description": "Manage state", "subcommands": [{ "name": "list", "description": "List resources" }, { "name": "show", "description": "Show a resource", "arguments": [{ "name": "address", "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }] }, { "name": "rm", "description": "Remove resources", "arguments": [{ "name": "address", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }] }, { "name": "mv", "description": "Move a resource", "arguments": [{ "name": "source", "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }, { "name": "destination", "type": { "type": "String" } }] }] },
    { "name": "taint", "description": "Mark a resource as tainted", "arguments": [{ "name": "address", "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }] },
    { "name": "untaint", "description": "Remove taint from a resource", "arguments": [{ "name": "address", "type": { "type": "Dynamic", "data": { "provider": "terraform.resource" } } }] },
    { "name": "validate", "description": "Validate configuration" },
    { "name": "fmt", "description": "Rewrite Terraform files to canonical format" },
    {
      "name": "workspace",
      "description": "Manage workspaces",
      "subcommands": [
        { "name": "list", "description": "List workspaces" },
        { "name": "new", "description": "Create workspace" },
        { "name": "select", "description": "Select workspace", "arguments": [{ "name": "workspace", "description": "Workspace name", "type": { "type": "Dynamic", "data": { "provider": "terraform.workspace" } } }] },
        { "name": "delete", "description": "Delete workspace", "arguments": [{ "name": "workspace", "description": "Workspace name", "type": { "type": "Dynamic", "data": { "provider": "terraform.workspace" } } }] }
      ]
    },
    { "name": "output", "description": "Show output values from the root module" },
    { "name": "show", "description": "Show the current state or a saved plan", "arguments": [{ "name": "plan_or_state", "description": "Plan or state file", "required": false, "type": { "type": "File", "data": {} } }] },
    { "name": "refresh", "description": "Sync state with real infrastructure" },
    { "name": "providers", "description": "Show providers required by the configuration" },
    { "name": "console", "description": "Open an interactive console for evaluating expressions" },
    { "name": "graph", "description": "Generate a Graphviz graph of the configuration" },
    { "name": "force-unlock", "description": "Release a stuck lock on the state", "arguments": [{ "name": "lock_id", "description": "Lock ID" }] },
    { "name": "login", "description": "Log in to a Terraform Cloud hostname" },
    { "name": "logout", "description": "Log out from a Terraform Cloud hostname" },
    { "name": "get", "description": "Download and update modules in the root module" },
    { "name": "test", "description": "Execute integration tests for the configuration" },
    { "name": "version", "description": "Show the current Terraform version" }
  ]
}
