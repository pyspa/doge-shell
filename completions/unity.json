              "name": "client",
              "type": {
                "type": "Choice",
                "data": [
                  "claude-code",
                  "claude-desktop",
                  "grok",
                  "cursor",
                  "windsurf",
                  "vscode",
                  "cline",
                  "codex"
                ]
              },
              "required": false
            }
          ]
        },
        {
          "name": "show",
          "description": "Print agent skill"
