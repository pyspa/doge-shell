{
  "command": "vault",
  "description": "HashiCorp Vault CLI",
  "global_options": [
    { "long": "--address", "description": "Vault server address", "takes_value": true, "value_type": { "type": "Url" } },
    { "long": "--namespace", "description": "Vault namespace", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--ca-cert", "description": "CA certificate", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--client-cert", "description": "Client certificate", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--client-key", "description": "Client key", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--format", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["table", "json", "yaml", "pretty", "raw"] } }
  ],
  "subcommands": [
    { "name": "login", "description": "Authenticate to Vault", "options": [{ "short": "-m", "long": "--method", "description": "Authentication method", "takes_value": true, "value_type": { "type": "String" } }] },
    { "name": "status", "description": "Print seal and HA status" },
    { "name": "server", "description": "Start a Vault server", "options": [{ "long": "--config", "description": "Configuration file or directory", "takes_value": true, "value_type": { "type": "File", "data": {} } }] },
    { "name": "read", "description": "Read data from Vault", "arguments": [{ "name": "path", "description": "Vault path" }] },
    { "name": "write", "description": "Write data to Vault", "arguments": [{ "name": "path", "description": "Vault path" }, { "name": "data", "description": "key=value data", "multiple": true }] },
    { "name": "delete", "description": "Delete data from Vault", "arguments": [{ "name": "path", "description": "Vault path" }] },
    { "name": "list", "description": "List data from Vault", "arguments": [{ "name": "path", "description": "Vault path" }] },
    { "name": "kv", "description": "Interact with KV secrets", "subcommands": [{ "name": "get", "description": "Read a secret" }, { "name": "put", "description": "Write a secret" }, { "name": "patch", "description": "Patch a secret" }, { "name": "delete", "description": "Delete secret versions" }, { "name": "destroy", "description": "Destroy secret versions" }, { "name": "list", "description": "List secrets" }, { "name": "metadata", "description": "Manage secret metadata" }] },
    { "name": "auth", "description": "Manage auth methods" },
    { "name": "secrets", "description": "Manage secrets engines" },
    { "name": "policy", "description": "Manage policies" },
    { "name": "token", "description": "Manage tokens" },
    { "name": "operator", "description": "Operator-specific commands" },
    { "name": "lease", "description": "Manage leases" },
    { "name": "namespace", "description": "Manage namespaces" },
    { "name": "version", "description": "Print version information" }
  ]
}
