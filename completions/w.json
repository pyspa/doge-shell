{
  "command": "w",
  "description": "Show who is logged on and what they are doing",
  "global_options": [
    {
      "short": "-h",
      "long": "--no-header",
      "description": "Don't print the header"
    },
    {
      "short": "-u",
      "long": "--no-current",
      "description": "Ingore current process username"
    },
    {
      "short": "-s",
      "long": "--short",
      "description": "Use the short format"
    },
    {
      "short": "-f",
      "long": "--from",
      "description": "Toggle the FROM field"
    },
    {
      "long": "--help",
      "description": "Display this help and exit"
    },
    {
      "short": "-i",
      "long": "--ip-addr",
      "description": "Show the IP address instead of the hostname"
    },
    {
      "short": "-o",
      "long": "--old-style",
      "description": "Old style output"
    },
    {
      "short": "-p",
      "long": "--pids",
      "description": "Show the PID of the active process"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "user",
      "description": "Only show this user",
      "required": false,
      "type": {
        "type": "User"
      }
    }
  ]
}
