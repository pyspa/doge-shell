{
  "command": "wait",
  "description": "Wait for background jobs and report their exit status",
  "global_options": [
    {
      "short": "-n",
      "description": "Wait for the next background job to terminate"
    },
    {
      "short": "-p",
      "description": "Assign the completed job's PID to a shell variable",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    }
  ],
  "arguments": [
    {
      "name": "id",
      "description": "PID or job specification",
      "required": false,
      "multiple": true,
      "type": { "type": "Dynamic", "data": { "provider": "shell.job" } }
    }
  ],
  "subcommands": []
}
