{
  "command": "watchexec",
  "description": "Run commands when files change",
  "global_options": [
    {
      "short": "-w",
      "long": "--watch",
      "description": "Path to watch",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-f",
      "long": "--filter",
      "description": "Glob filter",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-i",
      "long": "--ignore",
      "description": "Ignored pattern",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-e",
      "long": "--exts",
      "description": "File extensions",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "short": "-c",
      "long": "--clear",
      "description": "Clear screen"
    },
    {
      "short": "-r",
      "long": "--restart",
      "description": "Restart running command"
    },
    {
      "short": "-d",
      "long": "--debounce",
      "description": "Debounce interval",
      "takes_value": true,
      "value_type": {
        "type": "String"
      }
    },
    {
      "long": "--shell",
      "description": "Shell to use",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    }
  ],
  "arguments": [
    {
      "name": "command",
      "multiple": true,
      "type": {
        "type": "CommandWithArgs"
      }
    }
  ]
}
