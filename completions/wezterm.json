{
  "command": "wezterm",
  "description": "GPU-accelerated terminal emulator and multiplexer",
  "global_options": [
    { "short": "-n", "long": "--skip-config", "description": "Skip loading configuration" },
    { "long": "--config-file", "description": "Configuration file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--config", "description": "Override a configuration value", "takes_value": true, "value_type": { "type": "String" } }
  ],
  "subcommands": [
    { "name": "start", "description": "Start a GUI instance", "options": [{ "long": "--cwd", "description": "Working directory", "takes_value": true, "value_type": { "type": "Directory" } }], "arguments": [{ "name": "program", "description": "Program and arguments", "required": false, "multiple": true }] },
    { "name": "ssh", "description": "Connect to an SSH host", "arguments": [{ "name": "host", "description": "SSH host", "type": { "type": "Dynamic", "data": { "provider": "ssh.host" } } }] },
    { "name": "serial", "description": "Connect to a serial device", "arguments": [{ "name": "device", "description": "Serial device", "type": { "type": "File", "data": {} } }] },
    { "name": "connect", "description": "Connect to a multiplexer domain" },
    { "name": "cli", "description": "Control a running WezTerm", "subcommands": [{ "name": "list", "description": "List panes" }, { "name": "spawn", "description": "Spawn a command" }, { "name": "split-pane", "description": "Split a pane" }, { "name": "activate-pane", "description": "Activate a pane" }, { "name": "kill-pane", "description": "Kill a pane" }, { "name": "send-text", "description": "Send text to a pane" }, { "name": "set-tab-title", "description": "Set tab title" }, { "name": "set-window-title", "description": "Set window title" }] },
    { "name": "imgcat", "description": "Display an image", "arguments": [{ "name": "image", "description": "Image file", "type": { "type": "File", "data": {} } }] },
    { "name": "set-working-directory", "description": "Emit a working-directory escape sequence", "arguments": [{ "name": "directory", "description": "Working directory", "type": { "type": "Directory" } }] },
    { "name": "show-keys", "description": "Show key assignments" },
    { "name": "ls-fonts", "description": "List available fonts" }
  ]
}
