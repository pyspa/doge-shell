{
  "command": "abbr",
  "description": "Manage shell abbreviations",
  "global_options": [
    { "short": "-a", "long": "--add", "description": "Add abbreviation" },
    { "short": "-e", "long": "--erase", "description": "Erase abbreviation" },
    { "short": "-l", "long": "--list", "description": "List abbreviations" },
    { "short": "-s", "long": "--show", "description": "Show abbreviations" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [
    { "name": "name", "description": "Abbreviation name", "type": { "type": "Dynamic", "data": { "provider": "shell.abbr" } } },
    { "name": "expansion", "description": "Expansion text", "multiple": true, "type": { "type": "CommandWithArgs" } }
  ]
}
