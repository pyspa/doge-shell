{
  "command": "age",
  "description": "Encrypt and decrypt files",
  "global_options": [
    { "short": "-e", "long": "--encrypt", "description": "Encrypt" },
    { "short": "-d", "long": "--decrypt", "description": "Decrypt" },
    { "short": "-r", "long": "--recipient", "description": "Recipient", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-i", "long": "--identity", "description": "Identity file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "short": "-o", "long": "--output", "description": "Output file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "short": "-p", "long": "--passphrase", "description": "Encrypt with passphrase" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [{ "name": "file", "description": "Input file", "multiple": true, "type": { "type": "File", "data": {} } }]
}
