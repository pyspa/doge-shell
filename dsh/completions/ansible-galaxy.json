{
  "command": "ansible-galaxy",
  "description": "Manage Ansible collections and roles",
  "global_options": [
    { "short": "-s", "long": "--server", "description": "Galaxy server", "takes_value": true, "value_type": { "type": "Url" } },
    { "short": "-c", "long": "--ignore-certs", "description": "Ignore TLS certs" },
    { "short": "-v", "long": "--verbose", "description": "Verbose output" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "collection", "description": "Manage collections", "subcommands": [{ "name": "install", "description": "Install collection" }, { "name": "list", "description": "List collections" }, { "name": "verify", "description": "Verify collection" }, { "name": "build", "description": "Build collection" }, { "name": "publish", "description": "Publish collection" }] },
    { "name": "role", "description": "Manage roles", "subcommands": [{ "name": "install", "description": "Install role" }, { "name": "list", "description": "List roles" }, { "name": "init", "description": "Create role" }, { "name": "remove", "description": "Remove role" }] }
  ]
}
