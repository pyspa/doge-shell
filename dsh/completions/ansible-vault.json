{
  "command": "ansible-vault",
  "description": "Encrypt and edit Ansible Vault files",
  "global_options": [
    { "long": "--vault-id", "description": "Vault ID", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--vault-password-file", "description": "Vault password file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "create", "description": "Create encrypted file", "arguments": [{ "name": "file", "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] },
    { "name": "decrypt", "description": "Decrypt file", "arguments": [{ "name": "file", "multiple": true, "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] },
    { "name": "edit", "description": "Edit encrypted file", "arguments": [{ "name": "file", "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] },
    { "name": "encrypt", "description": "Encrypt file", "arguments": [{ "name": "file", "multiple": true, "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] },
    { "name": "rekey", "description": "Change vault key", "arguments": [{ "name": "file", "multiple": true, "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] },
    { "name": "view", "description": "View encrypted file", "arguments": [{ "name": "file", "type": { "type": "File", "data": { "extensions": ["yml", "yaml"] } } }] }
  ]
}
