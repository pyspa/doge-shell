{
  "command": "az",
  "description": "Azure CLI",
  "global_options": [
    { "long": "--subscription", "description": "Azure subscription", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.subscription" } } },
    { "long": "--output", "short": "-o", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["json", "jsonc", "yaml", "table", "tsv", "none"] } },
    { "long": "--query", "description": "JMESPath query string", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--debug", "description": "Increase logging verbosity" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "login", "description": "Log in to Azure" },
    { "name": "account", "description": "Manage Azure subscriptions", "subcommands": [{ "name": "show", "description": "Show current subscription" }, { "name": "list", "description": "List subscriptions" }, { "name": "set", "description": "Set active subscription" }] },
    { "name": "group", "description": "Manage resource groups", "subcommands": [{ "name": "list", "description": "List resource groups" }, { "name": "show", "description": "Show a resource group", "options": [{ "short": "-n", "long": "--name", "description": "Resource group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }] }, { "name": "delete", "description": "Delete a resource group", "options": [{ "short": "-n", "long": "--name", "description": "Resource group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }] }] },
    { "name": "vm", "description": "Manage virtual machines", "subcommands": [{ "name": "list", "description": "List virtual machines" }, { "name": "show", "description": "Show a virtual machine", "options": [{ "short": "-g", "long": "--resource-group", "description": "Resource group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }, { "short": "-n", "long": "--name", "description": "VM name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.vm" } } }] }, { "name": "start", "description": "Start a virtual machine", "options": [{ "short": "-g", "long": "--resource-group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }, { "short": "-n", "long": "--name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.vm" } } }] }, { "name": "stop", "description": "Stop a virtual machine", "options": [{ "short": "-g", "long": "--resource-group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }, { "short": "-n", "long": "--name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.vm" } } }] }] },
    { "name": "aks", "description": "Manage Azure Kubernetes Service", "subcommands": [{ "name": "list", "description": "List AKS clusters" }, { "name": "show", "description": "Show an AKS cluster", "options": [{ "short": "-g", "long": "--resource-group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }, { "short": "-n", "long": "--name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.aks_cluster" } } }] }, { "name": "get-credentials", "description": "Get AKS credentials", "options": [{ "short": "-g", "long": "--resource-group", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.resource_group" } } }, { "short": "-n", "long": "--name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "az.aks_cluster" } } }] }] },
    { "name": "storage", "description": "Manage storage accounts" },
    { "name": "webapp", "description": "Manage web apps" },
    { "name": "functionapp", "description": "Manage function apps" }
  ]
}
