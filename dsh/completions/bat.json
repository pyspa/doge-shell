{
  "command": "bat",
  "description": "A cat clone with syntax highlighting",
  "global_options": [
    {
      "short": "-A",
      "long": "--show-all",
      "description": "Show non-printable characters"
    },
    {
      "short": "-l",
      "long": "--language",
      "description": "Set syntax language",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "bat.language" } }
    },
    {
      "short": "-n",
      "long": "--number",
      "description": "Show line numbers"
    },
    {
      "short": "-p",
      "long": "--plain",
      "description": "Plain output (no decorations)"
    },
    {
      "long": "--paging",
      "description": "Control paging (auto, never, always)",
      "takes_value": true,
      "value_type": { "type": "Choice", "data": ["auto", "never", "always"] }
    },
    {
      "long": "--theme",
      "description": "Set color theme",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "bat.theme" } }
    },
    {
      "long": "--map-syntax",
      "short": "-m",
      "description": "Map a glob pattern to an existing syntax name",
      "takes_value": true
    },
    {
      "long": "--wrap",
      "description": "Text wrapping mode",
      "takes_value": true,
      "value_type": { "type": "Choice", "data": ["auto", "never", "character"] }
    },
    {
      "long": "--pager",
      "description": "Pager command to use",
      "takes_value": true,
      "value_type": { "type": "Command" }
    },
    {
      "long": "--list-themes",
      "description": "List available themes"
    },
    {
      "long": "--list-languages",
      "description": "List supported languages"
    },
    {
      "short": "-r",
      "long": "--line-range",
      "description": "Show specific line range",
      "takes_value": true
    },
    {
      "long": "--diff",
      "description": "Show git diff"
    },
    {
      "long": "--color",
      "description": "Control color output (auto, always, never)",
      "takes_value": true,
      "value_type": { "type": "Choice", "data": ["auto", "always", "never"] }
    },
    {
      "long": "--decorations",
      "description": "Control decoration output",
      "takes_value": true,
      "value_type": { "type": "Choice", "data": ["auto", "always", "never"] }
    },
    {
      "long": "--style",
      "description": "Comma-separated style options",
      "takes_value": true
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    }
  ],
  "arguments": [
    {
      "name": "file",
      "description": "File to display",
      "type": {
        "type": "File",
        "data": {}
      }
    }
  ]
}
