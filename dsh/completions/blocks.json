{
  "command": "blocks",
  "description": "List and inspect command blocks",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "list", "aliases": ["-l", "--list"], "description": "List blocks", "options": [{ "short": "-n", "long": "--limit", "description": "Limit entries", "takes_value": true, "value_type": { "type": "Number" } }, { "long": "--failed", "description": "Only failed blocks" }, { "long": "--watched", "description": "Only watched blocks" }] },
    { "name": "show", "description": "Show block", "arguments": [{ "name": "index", "description": "Block index", "type": { "type": "Number" } }], "options": [{ "long": "--stdout", "description": "Show stdout" }, { "long": "--stderr", "description": "Show stderr" }, { "long": "--all", "description": "Show all output" }] },
    { "name": "command", "description": "Print command", "arguments": [{ "name": "index", "description": "Block index", "type": { "type": "Number" } }] },
    { "name": "rerun", "description": "Rerun block", "arguments": [{ "name": "index", "description": "Block index", "type": { "type": "Number" } }] },
    { "name": "explain", "description": "Explain block", "arguments": [{ "name": "index", "description": "Block index", "type": { "type": "Number" } }] },
    { "name": "clear", "aliases": ["-c", "--clear"], "description": "Clear blocks" },
    { "name": "help", "description": "Show help" }
  ],
  "arguments": [{ "name": "index", "description": "Block index", "type": { "type": "Number" } }]
}
