{
  "command": "doctl",
  "description": "DigitalOcean CLI",
  "global_options": [
    { "short": "-t", "long": "--access-token", "description": "API token", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--context", "description": "Authentication context", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-o", "long": "--output", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["text", "json"] } },
    { "long": "--trace", "description": "Show API requests" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "auth", "description": "Manage authentication" },
    { "name": "account", "description": "Account information" },
    { "name": "compute", "description": "Manage compute resources" },
    { "name": "kubernetes", "aliases": ["k8s"], "description": "Manage Kubernetes clusters" },
    { "name": "databases", "description": "Manage databases" },
    { "name": "apps", "description": "Manage App Platform apps" },
    { "name": "registry", "description": "Manage container registry" }
  ]
}
