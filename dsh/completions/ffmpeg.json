{
  "command": "ffmpeg",
  "description": "Convert, record, and stream audio/video",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" },
    { "long": "-version", "description": "Show version" },
    { "short": "-y", "description": "Overwrite output files" },
    { "short": "-n", "description": "Do not overwrite output files" },
    {
      "short": "-v",
      "long": "-loglevel",
      "description": "Set logging level",
      "takes_value": true,
      "value_type": {
        "type": "Choice",
        "data": ["quiet", "panic", "fatal", "error", "warning", "info", "verbose", "debug", "trace"]
      }
    },
    {
      "short": "-i",
      "description": "Input file or stream",
      "takes_value": true,
      "value_type": { "type": "File", "data": {} }
    },
    { "short": "-f", "description": "Force input or output format", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.format" } } },
    { "short": "-ss", "description": "Seek to timestamp", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-to", "description": "Stop writing at timestamp", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-t", "description": "Limit duration", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-codec", "description": "Set codec", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-c", "description": "Set codec", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-c:v", "description": "Set video codec", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-c:a", "description": "Set audio codec", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-c:s", "description": "Set subtitle codec", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-vcodec", "description": "Set video codec (legacy alias)", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-acodec", "description": "Set audio codec (legacy alias)", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-scodec", "description": "Set subtitle codec (legacy alias)", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.encoder" } } },
    { "short": "-decoder", "description": "Force a decoder for the input stream", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "ffmpeg.decoder" } } },
    { "short": "-b:v", "description": "Video bitrate", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-b:a", "description": "Audio bitrate", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-crf", "description": "Constant rate factor", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-preset", "description": "Encoder speed preset", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-r", "description": "Set frame rate", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-s", "description": "Set frame size (WxH)", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-map", "description": "Select an input stream for the output", "takes_value": true, "multiple": true, "value_type": { "type": "String" } },
    { "short": "-vf", "description": "Video filter graph", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-af", "description": "Audio filter graph", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-vn", "description": "Disable video recording" },
    { "short": "-an", "description": "Disable audio recording" },
    { "short": "-sn", "description": "Disable subtitle recording" },
    { "short": "-stats", "description": "Print progress statistics" },
    { "short": "-filter_complex", "description": "Complex filter graph", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "-encoders", "description": "List available encoders" },
    { "long": "-decoders", "description": "List available decoders" },
    { "long": "-formats", "description": "List available formats" },
    { "long": "-hide_banner", "description": "Suppress the build banner" }
  ],
  "arguments": [
    {
      "name": "output",
      "description": "Output file",
      "type": { "type": "File", "data": {} }
    }
  ]
}
