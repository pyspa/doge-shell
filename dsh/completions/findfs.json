{
  "command": "findfs",
  "description": "Find a filesystem by label or UUID",
  "arguments": [
    {
      "name": "specifier",
      "description": "Filesystem specifier (LABEL=, UUID=, PARTUUID=, PARTLABEL=)",
      "type": {
        "type": "Choice",
        "data": [
          "LABEL=",
          "UUID=",
          "PARTUUID=",
          "PARTLABEL="
        ]
      }
    }
  ],
  "global_options": [
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ]
}
