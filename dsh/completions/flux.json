{
  "command": "flux",
  "description": "Flux GitOps toolkit CLI",
  "global_options": [
    { "long": "--context", "description": "Kubernetes context", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "kubectl.context" } } },
    { "short": "-n", "long": "--namespace", "description": "Kubernetes namespace", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "kubectl.namespace" } } },
    { "long": "--kubeconfig", "description": "Path to kubeconfig", "takes_value": true, "value_type": { "type": "File", "data": {} } }
  ],
  "subcommands": [
    { "name": "bootstrap", "description": "Bootstrap Flux", "subcommands": [{ "name": "github", "description": "Bootstrap from GitHub" }, { "name": "gitlab", "description": "Bootstrap from GitLab" }, { "name": "gitea", "description": "Bootstrap from Gitea" }, { "name": "git", "description": "Bootstrap from a Git repository" }] },
    { "name": "check", "description": "Check prerequisites and installation" },
    { "name": "create", "description": "Create Flux resources", "subcommands": [{ "name": "source", "description": "Create a source" }, { "name": "kustomization", "description": "Create a Kustomization" }, { "name": "helmrelease", "description": "Create a HelmRelease" }] },
    { "name": "delete", "description": "Delete Flux resources", "subcommands": [{ "name": "kustomization", "description": "Delete a Kustomization", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "kustomizations.kustomize.toolkit.fluxcd.io" } } }] }, { "name": "helmrelease", "description": "Delete a HelmRelease", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "helmreleases.helm.toolkit.fluxcd.io" } } }] }] },
    { "name": "export", "description": "Export Flux resources" },
    { "name": "get", "description": "Get Flux resources", "subcommands": [{ "name": "all", "description": "Get all resources" }, { "name": "sources", "description": "Get sources" }, { "name": "kustomizations", "description": "Get Kustomizations" }, { "name": "helmreleases", "description": "Get HelmReleases" }] },
    { "name": "reconcile", "description": "Reconcile Flux resources", "subcommands": [{ "name": "kustomization", "description": "Reconcile a Kustomization", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "kustomizations.kustomize.toolkit.fluxcd.io" } } }] }, { "name": "helmrelease", "description": "Reconcile a HelmRelease", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "helmreleases.helm.toolkit.fluxcd.io" } } }] }, { "name": "source", "description": "Reconcile a source", "subcommands": [{ "name": "git", "description": "Reconcile a GitRepository", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "gitrepositories.source.toolkit.fluxcd.io" } } }] }, { "name": "helm", "description": "Reconcile a HelmRepository", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "helmrepositories.source.toolkit.fluxcd.io" } } }] }] }] },
    { "name": "resume", "description": "Resume Flux resources", "subcommands": [{ "name": "kustomization", "description": "Resume a Kustomization", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "kustomizations.kustomize.toolkit.fluxcd.io" } } }] }, { "name": "helmrelease", "description": "Resume a HelmRelease", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "helmreleases.helm.toolkit.fluxcd.io" } } }] }] },
    { "name": "suspend", "description": "Suspend Flux resources", "subcommands": [{ "name": "kustomization", "description": "Suspend a Kustomization", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "kustomizations.kustomize.toolkit.fluxcd.io" } } }] }, { "name": "helmrelease", "description": "Suspend a HelmRelease", "arguments": [{ "name": "name", "type": { "type": "Dynamic", "data": { "provider": "kubectl.resource_name", "scope": "helmreleases.helm.toolkit.fluxcd.io" } } }] }] },
    { "name": "logs", "description": "Display Flux logs" },
    { "name": "trace", "description": "Trace a Kubernetes object" },
    { "name": "uninstall", "description": "Uninstall Flux" },
    { "name": "version", "description": "Print version information" }
  ]
}
