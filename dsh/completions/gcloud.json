{
  "command": "gcloud",
  "description": "Google Cloud CLI",
  "global_options": [
    { "long": "--project", "description": "Google Cloud project ID", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "gcloud.project" } } },
    { "long": "--account", "description": "Google account", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "gcloud.account" } } },
    { "long": "--configuration", "description": "Named gcloud configuration", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "gcloud.configuration" } } },
    { "long": "--format", "description": "Output format", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "auth", "description": "Manage credentials", "subcommands": [{ "name": "login", "description": "Log in" }, { "name": "list", "description": "List credentialed accounts" }, { "name": "activate-service-account", "description": "Use service account credentials" }] },
    { "name": "config", "description": "Manage CLI configuration", "subcommands": [{ "name": "set", "description": "Set property" }, { "name": "get-value", "description": "Get property" }, { "name": "list", "description": "List properties" }, { "name": "configurations", "description": "Manage named configurations" }] },
    { "name": "projects", "description": "Manage projects" },
    { "name": "compute", "description": "Compute Engine commands", "subcommands": [{ "name": "instances", "description": "Manage VM instances", "subcommands": [{ "name": "list", "description": "List VM instances" }, { "name": "describe", "description": "Describe a VM instance", "arguments": [{ "name": "instance", "type": { "type": "Dynamic", "data": { "provider": "gcloud.compute_instance" } } }] }, { "name": "start", "description": "Start VM instances", "arguments": [{ "name": "instance", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "gcloud.compute_instance" } } }] }, { "name": "stop", "description": "Stop VM instances", "arguments": [{ "name": "instance", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "gcloud.compute_instance" } } }] }, { "name": "ssh", "description": "Connect to a VM instance", "arguments": [{ "name": "instance", "type": { "type": "Dynamic", "data": { "provider": "gcloud.compute_instance" } } }] }] }] },
    { "name": "container", "description": "Kubernetes Engine commands", "subcommands": [{ "name": "clusters", "description": "Manage GKE clusters", "subcommands": [{ "name": "list", "description": "List GKE clusters" }, { "name": "describe", "description": "Describe a GKE cluster", "arguments": [{ "name": "cluster", "type": { "type": "Dynamic", "data": { "provider": "gcloud.gke_cluster" } } }] }, { "name": "get-credentials", "description": "Update kubeconfig for a cluster", "arguments": [{ "name": "cluster", "type": { "type": "Dynamic", "data": { "provider": "gcloud.gke_cluster" } } }] }, { "name": "delete", "description": "Delete a GKE cluster", "arguments": [{ "name": "cluster", "type": { "type": "Dynamic", "data": { "provider": "gcloud.gke_cluster" } } }] }] }] },
    { "name": "run", "description": "Cloud Run commands" },
    { "name": "functions", "description": "Cloud Functions commands" },
    { "name": "storage", "description": "Cloud Storage commands" }
  ]
}
