{
  "command": "gh",
  "description": "GitHub CLI",
  "global_options": [
    {
      "short": "-R",
      "long": "--repo",
      "description": "Select another repository",
      "takes_value": true,
      "value_type": { "type": "Dynamic", "data": { "provider": "gh.repository" } }
    },
    {
      "long": "--help",
      "description": "Show help"
    },
    {
      "long": "--version",
      "description": "Show version"
    }
  ],
  "subcommands": [
    {
      "name": "pr",
      "description": "Manage pull requests",
      "subcommands": [
        {
          "name": "list",
          "description": "List pull requests",
          "options": [
            { "short": "-s", "long": "--state", "description": "Filter by state (open, closed, merged, all)" },
            { "short": "-l", "long": "--label", "description": "Filter by label" },
            { "short": "-a", "long": "--author", "description": "Filter by author" },
            { "short": "-A", "long": "--assignee", "description": "Filter by assignee", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-B", "long": "--base", "description": "Filter by base branch", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-H", "long": "--head", "description": "Filter by head branch", "takes_value": true, "value_type": { "type": "String" } },
            { "short": "-L", "long": "--limit", "description": "Maximum number of items", "takes_value": true, "value_type": { "type": "Number" } },
            { "short": "-S", "long": "--search", "description": "Search pull requests", "takes_value": true, "value_type": { "type": "String" } },
            { "long": "--draft", "description": "Filter by draft state" }
          ]
        },
        {
          "name": "view",
          "description": "View a pull request",
          "arguments": [
            {
              "name": "number",
              "description": "PR number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } }
            }
          ]
        },
        {
          "name": "checkout",
          "description": "Check out a pull request locally",
          "arguments": [
            {
              "name": "number",
              "description": "PR number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } }
            }
          ]
        },
        { "name": "create", "description": "Create a pull request" },
        { "name": "close", "description": "Close a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "merge", "description": "Merge a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "ready", "description": "Mark a pull request as ready for review", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "diff", "description": "View changes in a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] },
        { "name": "comment", "description": "Add a comment to a pull request", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.pull_request" } } }] }
      ]
    },
    {
      "name": "issue",
      "description": "Manage issues",
      "subcommands": [
        {
          "name": "list",
          "description": "List issues",
          "options": [
            { "short": "-s", "long": "--state", "description": "Filter by state (open, closed, all)" },
            { "short": "-l", "long": "--label", "description": "Filter by label" },
            { "short": "-a", "long": "--assignee", "description": "Filter by assignee" }
          ]
        },
        {
          "name": "view",
          "description": "View an issue",
          "arguments": [
            {
              "name": "number",
              "description": "Issue number",
              "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } }
            }
          ]
        },
        { "name": "create", "description": "Create an issue" },
        { "name": "close", "description": "Close an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] },
        { "name": "reopen", "description": "Reopen an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] },
        { "name": "comment", "description": "Add a comment to an issue", "arguments": [{ "name": "number", "type": { "type": "Dynamic", "data": { "provider": "gh.issue" } } }] }
      ]
    },
    {
      "name": "repo",
      "description": "Manage repositories",
      "subcommands": [
        { "name": "clone", "description": "Clone a repository", "arguments": [{ "name": "repository", "type": { "type": "Dynamic", "data": { "provider": "gh.repository" } } }] },
        { "name": "create", "description": "Create a repository" },
        { "name": "fork", "description": "Fork a repository" },
        { "name": "view", "description": "View a repository", "arguments": [{ "name": "repository", "type": { "type": "Dynamic", "data": { "provider": "gh.repository" } } }] },
        { "name": "list", "description": "List repositories" }
      ]
    },
    {
      "name": "workflow",
      "description": "View and run GitHub Actions workflows",
      "subcommands": [
        { "name": "list", "description": "List workflows" },
        { "name": "run", "description": "Run a workflow", "arguments": [{ "name": "workflow", "type": { "type": "Dynamic", "data": { "provider": "gh.workflow" } } }] },
        { "name": "view", "description": "View a workflow", "arguments": [{ "name": "workflow", "type": { "type": "Dynamic", "data": { "provider": "gh.workflow" } } }] }
      ]
    },
    {
      "name": "run",
      "description": "View and manage workflow runs",
      "subcommands": [
        { "name": "list", "description": "List workflow runs" },
        {
          "name": "view",
          "description": "View a specific run",
          "arguments": [
            {
              "name": "run_id",
              "description": "Run ID",
              "type": { "type": "Dynamic", "data": { "provider": "gh.run" } }
            }
          ]
        },
        { "name": "watch", "description": "Watch a run until it completes", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "download", "description": "Download artifacts from a run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "rerun", "description": "Rerun a failed run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] },
        { "name": "cancel", "description": "Cancel a workflow run", "arguments": [{ "name": "run_id", "type": { "type": "Dynamic", "data": { "provider": "gh.run" } } }] }
      ]
    },
    {
      "name": "auth",
      "description": "Authenticate with GitHub",
      "subcommands": [
        { "name": "login", "description": "Authenticate with a GitHub host" },
        { "name": "logout", "description": "Log out of a GitHub host" },
        { "name": "status", "description": "View authentication status" },
        { "name": "refresh", "description": "Refresh stored authentication" }
      ]
    },
    {
      "name": "browse",
      "description": "Open repository in web browser"
    },
    {
      "name": "gist",
      "description": "Manage gists",
      "subcommands": [
        { "name": "create", "description": "Create a gist" },
        { "name": "list", "description": "List gists" },
        { "name": "view", "description": "View a gist" },
        { "name": "edit", "description": "Edit a gist" },
        { "name": "delete", "description": "Delete a gist" }
      ]
    }
  ]
}
