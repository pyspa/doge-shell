{
  "command": "ghq",
  "description": "Manage remote repository clones",
  "global_options": [
    {
      "short": "-r",
      "long": "--root",
      "description": "Repository root",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    }
  ],
  "subcommands": [
    {
      "name": "list",
      "description": "List repositories",
      "options": [
        {
          "short": "-p",
          "long": "--full-path",
          "description": "Print full paths"
        }
      ]
    },
    {
      "name": "get",
      "description": "Clone or update repositories",
      "options": [
        {
          "short": "-u",
          "long": "--update",
          "description": "Update existing repository"
        },
        {
          "short": "-s",
          "long": "--shallow",
          "description": "Shallow clone"
        }
      ],
      "arguments": [
        {
          "name": "repository",
          "multiple": true,
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "look",
      "description": "Print repository directory",
      "arguments": [
        {
          "name": "repository",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "ghq.repository"
            }
          }
        }
      ]
    },
    {
      "name": "root",
      "description": "Print repository root"
    },
    {
      "name": "create",
      "description": "Create a repository",
      "arguments": [
        {
          "name": "repository",
          "type": {
            "type": "String"
          }
        }
      ]
    }
  ]
}
