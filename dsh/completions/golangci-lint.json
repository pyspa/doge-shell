{
  "command": "golangci-lint",
  "description": "Fast Go linters runner",
  "global_options": [
    {
      "short": "-c",
      "long": "--config",
      "description": "Configuration file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "yml",
            "yaml",
            "toml",
            "json"
          ]
        }
      }
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run linters",
      "options": [
        {
          "short": "-E",
          "long": "--enable",
          "description": "Enable linter",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "golangci_lint.linter"
            }
          }
        },
        {
          "short": "-D",
          "long": "--disable",
          "description": "Disable linter",
          "takes_value": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "golangci_lint.linter"
            }
          }
        },
        {
          "long": "--timeout",
          "description": "Timeout",
          "takes_value": true,
          "value_type": {
            "type": "String"
          }
        },
        {
          "long": "--fix",
          "description": "Apply fixes"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "required": false,
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "go.package"
            }
          }
        }
      ]
    },
    {
      "name": "linters",
      "description": "List linters"
    },
    {
      "name": "config",
      "description": "Manage configuration"
    },
    {
      "name": "cache",
      "description": "Manage cache"
    },
    {
      "name": "fmt",
      "description": "Run formatters"
    },
    {
      "name": "version",
      "description": "Show version"
    }
  ]
}
