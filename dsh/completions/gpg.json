{
  "command": "gpg",
  "description": "GNU Privacy Guard",
  "global_options": [
    { "long": "--homedir", "description": "GnuPG home directory", "takes_value": true, "value_type": { "type": "Directory" } },
    { "long": "--armor", "short": "-a", "description": "ASCII armor output" },
    { "long": "--recipient", "short": "-r", "description": "Recipient", "takes_value": true, "value_type": { "type": "String" } },
    { "long": "--output", "short": "-o", "description": "Output file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--yes", "description": "Assume yes" },
    { "long": "--batch", "description": "Batch mode" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "--encrypt", "description": "Encrypt data" },
    { "name": "--decrypt", "description": "Decrypt data", "arguments": [{ "name": "file", "description": "Encrypted file", "type": { "type": "File", "data": {} } }] },
    { "name": "--sign", "description": "Sign data" },
    { "name": "--verify", "description": "Verify signature", "arguments": [{ "name": "file", "description": "Signature or signed file", "type": { "type": "File", "data": {} } }] },
    { "name": "--list-keys", "description": "List public keys" },
    { "name": "--list-secret-keys", "description": "List secret keys" },
    { "name": "--import", "description": "Import keys", "arguments": [{ "name": "file", "description": "Key file", "type": { "type": "File", "data": {} } }] },
    { "name": "--export", "description": "Export keys" }
  ],
  "arguments": [{ "name": "file", "description": "Input file", "multiple": true, "type": { "type": "File", "data": {} } }]
}
