{
  "command": "just",
  "description": "Just command runner",
  "global_options": [
    {
      "short": "-l",
      "long": "--list",
      "description": "List available recipes"
    },
    {
      "short": "-n",
      "long": "--dry-run",
      "description": "Print what would be done"
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    },
    {
      "short": "-q",
      "long": "--quiet",
      "description": "Quiet output"
    },
    {
      "short": "-f",
      "long": "--justfile",
      "description": "Use specified justfile",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "long": "--choose",
      "description": "Select recipe with fuzzy finder"
    },
    {
      "long": "--dump",
      "description": "Print justfile"
    },
    {
      "long": "--evaluate",
      "description": "Evaluate and print variables"
    },
    {
      "long": "--fmt",
      "description": "Format justfile"
    },
    {
      "long": "--summary",
      "description": "List recipes in short form"
    },
    {
      "long": "--variables",
      "description": "List all variables"
    },
    {
      "short": "-d",
      "long": "--working-directory",
      "description": "Use the given working directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "long": "--set",
      "description": "Override a variable",
      "takes_value": true,
      "multiple": true
    },
    {
      "long": "--show",
      "description": "Print the given recipe",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "project.task",
          "scope": "just"
        }
      }
    },
    {
      "long": "--unstable",
      "description": "Enable unstable features"
    },
    {
      "long": "--yes",
      "description": "Automatically confirm all recipes"
    },
    {
      "long": "--timestamp",
      "description": "Print recipe command timestamps"
    },
    {
      "long": "--no-deps",
      "description": "Don't run recipe dependencies"
    },
    {
      "short": "-g",
      "long": "--global-justfile",
      "description": "Use the global justfile"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "recipe",
      "description": "Recipe to run",
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "project.task",
          "scope": "just"
        }
      }
    }
  ]
}
