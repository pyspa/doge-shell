{
  "command": "k3d",
  "description": "Run k3s clusters in Docker",
  "global_options": [{ "long": "--trace", "description": "Enable trace logging" }, { "long": "--verbose", "description": "Enable verbose logging" }],
  "subcommands": [
    {
      "name": "cluster", "description": "Manage clusters",
      "subcommands": [
        { "name": "create", "description": "Create a cluster", "arguments": [{ "name": "name", "description": "Cluster name", "required": false }] },
        { "name": "list", "description": "List clusters" },
        { "name": "start", "description": "Start clusters", "arguments": [{ "name": "cluster", "description": "Cluster name", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] },
        { "name": "stop", "description": "Stop clusters", "arguments": [{ "name": "cluster", "description": "Cluster name", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] },
        { "name": "delete", "description": "Delete clusters", "arguments": [{ "name": "cluster", "description": "Cluster name", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] }
      ]
    },
    { "name": "node", "description": "Manage nodes", "subcommands": [{ "name": "create", "description": "Create a node" }, { "name": "list", "description": "List nodes" }, { "name": "start", "description": "Start nodes" }, { "name": "stop", "description": "Stop nodes" }, { "name": "delete", "description": "Delete nodes" }] },
    { "name": "registry", "description": "Manage registries", "subcommands": [{ "name": "create", "description": "Create a registry" }, { "name": "list", "description": "List registries" }, { "name": "delete", "description": "Delete registries" }] },
    { "name": "image", "description": "Manage images", "subcommands": [{ "name": "import", "description": "Import images into clusters", "options": [{ "short": "-c", "long": "--cluster", "description": "Cluster name", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] }] },
    { "name": "kubeconfig", "description": "Manage kubeconfig", "subcommands": [{ "name": "get", "description": "Get cluster kubeconfig", "arguments": [{ "name": "cluster", "description": "Cluster name", "type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] }, { "name": "merge", "description": "Merge cluster kubeconfigs", "arguments": [{ "name": "cluster", "description": "Cluster name", "multiple": true, "type": { "type": "Dynamic", "data": { "provider": "k3d.cluster" } } }] }] },
    { "name": "version", "description": "Print version information" }
  ]
}
