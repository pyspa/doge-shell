{
  "command": "lsof",
  "description": "List open files",
  "global_options": [
    {
      "short": "-h",
      "description": "Display help information"
    },
    {
      "short": "-v",
      "description": "Display version information"
    },
    {
      "short": "-i",
      "description": "Select internet files, optionally filtered by [46][proto][@host][:port]",
      "takes_value": true
    },
    {
      "long": "-i4",
      "description": "Select IPv4 files"
    },
    {
      "long": "-i6",
      "description": "Select IPv6 files"
    },
    {
      "short": "-p",
      "description": "Select files with listed PIDs",
      "takes_value": true,
      "multiple": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "system.process_pid"
        }
      }
    },
    {
      "short": "-u",
      "description": "Select files for listed users",
      "takes_value": true,
      "multiple": true,
      "value_type": {
        "type": "User"
      }
    },
    {
      "short": "-g",
      "description": "Select files by process group ID",
      "takes_value": true
    },
    {
      "short": "-c",
      "description": "Select files with command name",
      "takes_value": true,
      "multiple": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "system.process_name"
        }
      }
    },
    {
      "short": "-d",
      "description": "Select files with descriptor numbers",
      "takes_value": true
    },
    {
      "short": "-k",
      "description": "Read the kernel name list from the given file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-a",
      "description": "AND selections"
    },
    {
      "short": "-o",
      "description": "Do not list file offset"
    },
    {
      "short": "-n",
      "description": "No host name translation"
    },
    {
      "short": "-l",
      "description": "Inhibit conversion of user IDs to login names"
    },
    {
      "long": "+D",
      "description": "Search all open files under the given directory tree",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "long": "+d",
      "description": "Search open files in the given directory, without descending",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-N",
      "description": "Select NFS files"
    },
    {
      "short": "-P",
      "description": "Inhibit conversion of port numbers to port names for network files"
    },
    {
      "short": "-r",
      "description": "Repeat listing every t seconds",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-s",
      "description": "Select files by protocol and state, or display file size",
      "takes_value": true
    },
    {
      "short": "-t",
      "description": "Produce terse output with process identifiers only"
    },
    {
      "short": "-U",
      "description": "Select UNIX domain socket files"
    },
    {
      "long": "+c",
      "description": "Set command width to W",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-F",
      "description": "Produce field output for the listed field characters",
      "takes_value": true
    },
    {
      "short": "-X",
      "description": "Skip reporting information that can hang lsof"
    }
  ],
  "subcommands": [],
  "arguments": [
    {
      "name": "selection",
      "description": "File or directory to report open handles for",
      "required": false,
      "multiple": true,
      "type": {
        "type": "File",
        "data": {}
      }
    }
  ]
}
