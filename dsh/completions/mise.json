{
  "command": "mise",
  "description": "Development tool version and task manager",
  "global_options": [
    { "short": "-C", "long": "--cd", "description": "Change directory before running", "takes_value": true, "value_type": { "type": "Directory" } },
    { "short": "-v", "long": "--verbose", "description": "Increase verbosity" },
    { "short": "-q", "long": "--quiet", "description": "Decrease verbosity" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install tool versions",
      "options": [
        { "short": "-f", "long": "--force", "description": "Force reinstall even if already installed" },
        { "short": "-j", "long": "--jobs", "description": "Number of parallel jobs", "takes_value": true, "value_type": { "type": "Number" } }
      ],
      "arguments": [
        { "name": "tool", "description": "Tool@version spec", "multiple": true, "required": false }
      ]
    },
    {
      "name": "use",
      "description": "Use tool version in config",
      "options": [
        { "short": "-g", "long": "--global", "description": "Write to the global config" },
        { "long": "--pin", "description": "Pin the exact version" },
        { "long": "--remove", "description": "Remove the tool from the config", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "mise.tool" } } }
      ],
      "arguments": [
        { "name": "tool", "description": "Tool@version spec", "multiple": true, "required": false }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall an installed tool version",
      "arguments": [
        {
          "name": "tool",
          "description": "Installed tool",
          "multiple": true,
          "type": { "type": "Dynamic", "data": { "provider": "mise.tool" } }
        }
      ]
    },
    {
      "name": "list",
      "aliases": ["ls"],
      "description": "List installed versions",
      "options": [
        { "short": "-i", "long": "--installed", "description": "Only show installed versions" },
        { "short": "-c", "long": "--current", "description": "Only show active versions" },
        { "short": "-J", "long": "--json", "description": "JSON output" }
      ],
      "arguments": [
        {
          "name": "tool",
          "description": "Installed tool",
          "required": false,
          "type": { "type": "Dynamic", "data": { "provider": "mise.tool" } }
        }
      ]
    },
    {
      "name": "where",
      "description": "Show the install path of a tool version",
      "arguments": [
        {
          "name": "tool",
          "description": "Installed tool",
          "type": { "type": "Dynamic", "data": { "provider": "mise.tool" } }
        }
      ]
    },
    {
      "name": "current",
      "description": "Show current tool versions",
      "arguments": [
        {
          "name": "tool",
          "description": "Installed tool",
          "required": false,
          "type": { "type": "Dynamic", "data": { "provider": "mise.tool" } }
        }
      ]
    },
    { "name": "exec", "description": "Execute command with tool versions", "arguments": [{ "name": "command", "description": "Command to execute", "type": { "type": "Command" } }] },
    {
      "name": "run",
      "description": "Run a project task",
      "arguments": [
        { "name": "task", "description": "Task name", "type": { "type": "Dynamic", "data": { "provider": "project.task", "scope": "mise" } } }
      ]
    },
    { "name": "tasks", "description": "List project tasks" },
    { "name": "plugins", "description": "Manage plugins" }
  ]
}
