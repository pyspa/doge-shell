{
  "command": "mkarchroot",
  "description": "Create an Arch Linux chroot",
  "global_options": [
    {
      "short": "-U",
      "description": "Use pacman -U to install packages"
    },
    {
      "short": "-C",
      "description": "Pacman configuration",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "conf"
          ]
        }
      }
    },
    {
      "short": "-M",
      "description": "Makepkg configuration",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {
          "extensions": [
            "conf"
          ]
        }
      }
    },
    {
      "short": "-c",
      "description": "Package cache directory",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-f",
      "description": "Copy a host file as source[:destination]",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-s",
      "description": "Do not run setarch"
    },
    {
      "short": "-h",
      "description": "Show help"
    }
  ],
  "arguments": [
    {
      "name": "root",
      "type": {
        "type": "Directory"
      }
    },
    {
      "name": "package",
      "required": false,
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "pacman.package"
        }
      }
    }
  ]
}
