{
  "command": "modinfo",
  "description": "Show information about a Linux kernel module",
  "global_options": [
    {
      "short": "-a",
      "long": "--author",
      "description": "Print only the module author"
    },
    {
      "short": "-d",
      "long": "--description",
      "description": "Print only the module description"
    },
    {
      "short": "-l",
      "long": "--license",
      "description": "Print only the module license"
    },
    {
      "short": "-p",
      "long": "--parameters",
      "description": "Print only the module parameters"
    },
    {
      "short": "-n",
      "long": "--filename",
      "description": "Print only the module filename"
    },
    {
      "short": "-F",
      "long": "--field",
      "description": "Print only the given field",
      "takes_value": true
    },
    {
      "short": "-k",
      "long": "--set-version",
      "description": "Use the given kernel version instead of uname -r",
      "takes_value": true
    },
    {
      "short": "-b",
      "long": "--basedir",
      "description": "Use an alternative module directory root",
      "takes_value": true,
      "value_type": {
        "type": "Directory"
      }
    },
    {
      "short": "-0",
      "long": "--null",
      "description": "Use a NUL character instead of a newline as the field separator"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "module",
      "description": "Kernel module name or path",
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "kernel.module"
        }
      }
    }
  ]
}
