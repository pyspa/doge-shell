{
  "command": "ncat",
  "description": "Concatenate and redirect sockets",
  "global_options": [
    {
      "short": "-l",
      "long": "--listen",
      "description": "Listen mode"
    },
    {
      "short": "-p",
      "long": "--source-port",
      "description": "Source port",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-k",
      "long": "--keep-open",
      "description": "Accept multiple connections"
    },
    {
      "short": "-u",
      "long": "--udp",
      "description": "Use UDP"
    },
    {
      "short": "-U",
      "long": "--unixsock",
      "description": "Use Unix domain sockets"
    },
    {
      "short": "-e",
      "long": "--exec",
      "description": "Execute command",
      "takes_value": true,
      "value_type": {
        "type": "CommandWithArgs"
      }
    },
    {
      "short": "-c",
      "long": "--sh-exec",
      "description": "Execute shell command",
      "takes_value": true,
      "value_type": {
        "type": "CommandWithArgs"
      }
    },
    {
      "short": "-o",
      "long": "--output",
      "description": "Output file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Verbose output"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    }
  ],
  "arguments": [
    {
      "name": "host",
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "ssh.host"
        }
      }
    },
    {
      "name": "port",
      "type": {
        "type": "Number"
      }
    }
  ]
}
