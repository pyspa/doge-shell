{
  "command": "nix-env",
  "description": "Manipulate Nix user environments",
  "global_options": [
    { "short": "-i", "long": "--install", "description": "Install package" },
    { "short": "-e", "long": "--uninstall", "description": "Uninstall package" },
    { "short": "-q", "long": "--query", "description": "Query packages" },
    { "short": "-u", "long": "--upgrade", "description": "Upgrade packages" },
    { "short": "-A", "long": "--attr", "description": "Attribute path", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-f", "long": "--file", "description": "Nix expression file", "takes_value": true, "value_type": { "type": "File", "data": { "extensions": ["nix"] } } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [{ "name": "package", "multiple": true }]
}
