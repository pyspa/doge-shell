{
  "command": "out",
  "description": "Display command output history",
  "global_options": [
    { "short": "-l", "long": "--list", "description": "List outputs" },
    { "short": "-n", "long": "--limit", "description": "Limit list entries", "takes_value": true, "value_type": { "type": "Number" } },
    { "short": "-c", "long": "--clear", "description": "Clear output history" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "list", "description": "List outputs", "options": [{ "short": "-n", "long": "--limit", "description": "Limit list entries", "takes_value": true, "value_type": { "type": "Number" } }] },
    { "name": "clear", "description": "Clear output history" },
    { "name": "help", "description": "Show help" }
  ],
  "arguments": [{ "name": "index", "description": "Output index", "type": { "type": "Number" } }]
}
