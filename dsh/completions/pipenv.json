{
  "command": "pipenv",
  "description": "Python virtual environment and dependency manager",
  "global_options": [
    {
      "long": "--python",
      "description": "Python interpreter",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "long": "--venv",
      "description": "Show virtualenv path"
    },
    {
      "long": "--where",
      "description": "Show project path"
    },
    {
      "long": "--rm",
      "description": "Remove virtualenv"
    },
    {
      "long": "--bare",
      "description": "Minimal output"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a Pipfile script or command",
      "arguments": [
        {
          "name": "script",
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "pipenv.script"
            }
          }
        },
        {
          "name": "argument",
          "required": false,
          "multiple": true,
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "install",
      "description": "Install dependencies",
      "options": [
        {
          "short": "-d",
          "long": "--dev",
          "description": "Install development dependencies"
        }
      ],
      "arguments": [
        {
          "name": "package",
          "required": false,
          "multiple": true,
          "type": {
            "type": "String"
          }
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall dependencies",
      "arguments": [
        {
          "name": "package",
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "python.project_dependency"
            }
          }
        }
      ]
    },
    {
      "name": "update",
      "description": "Update dependencies",
      "arguments": [
        {
          "name": "package",
          "required": false,
          "multiple": true,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "python.project_dependency"
            }
          }
        }
      ]
    },
    {
      "name": "sync",
      "description": "Install from lock file"
    },
    {
      "name": "lock",
      "description": "Generate Pipfile.lock"
    },
    {
      "name": "shell",
      "description": "Spawn project shell"
    },
    {
      "name": "check",
      "description": "Check dependencies"
    }
  ]
}
