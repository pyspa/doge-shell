{
  "command": "pre-commit",
  "description": "Framework for managing multi-language pre-commit hooks",
  "global_options": [
    { "short": "-V", "long": "--version", "description": "Print version information" },
    { "long": "--color", "description": "Color output mode", "takes_value": true, "value_type": { "type": "Choice", "data": ["auto", "always", "never"] } }
  ],
  "subcommands": [
    { "name": "install", "description": "Install hook scripts", "options": [{ "short": "-t", "long": "--hook-type", "description": "Hook type", "takes_value": true, "value_type": { "type": "Choice", "data": ["pre-commit", "pre-push", "commit-msg", "prepare-commit-msg", "post-checkout", "post-commit", "post-merge", "post-rewrite"] } }, { "short": "-f", "long": "--overwrite", "description": "Replace existing hooks" }] },
    { "name": "uninstall", "description": "Uninstall hook scripts" },
    { "name": "run", "description": "Run hooks", "options": [{ "short": "-a", "long": "--all-files", "description": "Run on all files" }, { "long": "--files", "description": "Files to run hooks on", "takes_value": true, "value_type": { "type": "File", "data": {} } }, { "long": "--from-ref", "description": "Earlier revision", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "git.revision" } } }, { "long": "--to-ref", "description": "Later revision", "takes_value": true, "value_type": { "type": "Dynamic", "data": { "provider": "git.revision" } } }], "arguments": [{ "name": "hook", "description": "Hook id", "required": false, "type": { "type": "Dynamic", "data": { "provider": "pre_commit.hook_id" } } }] },
    { "name": "autoupdate", "description": "Update hook revisions" },
    { "name": "clean", "description": "Clean cached repositories" },
    { "name": "gc", "description": "Clean unused cached repositories" },
    { "name": "sample-config", "description": "Produce a sample configuration" },
    { "name": "try-repo", "description": "Try hooks from a repository", "arguments": [{ "name": "repo", "description": "Repository path or URL" }] },
    { "name": "validate-config", "description": "Validate configuration files", "arguments": [{ "name": "config", "description": "Configuration file", "multiple": true, "type": { "type": "File", "data": { "extensions": ["yaml", "yml"] } } }] },
    { "name": "validate-manifest", "description": "Validate hook manifests", "arguments": [{ "name": "manifest", "description": "Manifest file", "multiple": true, "type": { "type": "File", "data": { "extensions": ["yaml", "yml"] } } }] }
  ]
}
