{
  "command": "restic",
  "description": "Backup program",
  "global_options": [
    { "short": "-r", "long": "--repo", "description": "Repository", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-p", "long": "--password-file", "description": "Password file", "takes_value": true, "value_type": { "type": "File", "data": {} } },
    { "long": "--json", "description": "JSON output" },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "init", "description": "Initialize repository" },
    { "name": "backup", "description": "Create backup", "arguments": [{ "name": "path", "multiple": true, "type": { "type": "File", "data": {} } }] },
    { "name": "snapshots", "description": "List snapshots" },
    { "name": "restore", "description": "Restore snapshot", "arguments": [{ "name": "snapshot", "description": "Snapshot ID" }] },
    { "name": "forget", "description": "Remove snapshots" },
    { "name": "prune", "description": "Prune repository" },
    { "name": "check", "description": "Check repository" },
    { "name": "mount", "description": "Mount repository", "arguments": [{ "name": "mountpoint", "type": { "type": "Directory" } }] }
  ]
}
