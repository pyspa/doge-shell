{
  "command": "rmmod",
  "description": "Remove a module from the Linux kernel",
  "global_options": [
    {
      "short": "-f",
      "long": "--force",
      "description": "Force the removal even if the module is in use"
    },
    {
      "short": "-s",
      "long": "--syslog",
      "description": "Send errors to syslog instead of standard error"
    },
    {
      "short": "-v",
      "long": "--verbose",
      "description": "Print messages about what the program is doing"
    },
    {
      "short": "-h",
      "long": "--help",
      "description": "Show help"
    },
    {
      "short": "-V",
      "long": "--version",
      "description": "Show version"
    }
  ],
  "arguments": [
    {
      "name": "module",
      "description": "Loaded kernel module",
      "multiple": true,
      "type": {
        "type": "Dynamic",
        "data": {
          "provider": "kernel.module",
          "scope": "loaded"
        }
      }
    }
  ]
}
