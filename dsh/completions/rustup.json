{
  "command": "rustup",
  "description": "Rust toolchain manager",
  "subcommands": [
    {
      "name": "show",
      "description": "Show installed toolchains",
      "subcommands": [
        { "name": "active-toolchain", "description": "Show active toolchain" },
        { "name": "home", "description": "Show rustup home" },
        { "name": "profile", "description": "Show current profile" }
      ]
    },
    {
      "name": "update",
      "description": "Update installed toolchains"
    },
    {
      "name": "default",
      "description": "Set default toolchain",
      "arguments": [
        {
          "name": "toolchain",
          "description": "Toolchain to set as default",
          "type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
        }
      ]
    },
    {
      "name": "toolchain",
      "description": "Manage toolchains",
      "subcommands": [
        { "name": "list", "description": "List installed toolchains" },
        { "name": "install", "description": "Install a toolchain" },
        {
          "name": "uninstall",
          "description": "Uninstall a toolchain",
          "arguments": [
            {
              "name": "toolchain",
              "description": "Toolchain to uninstall",
              "type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
            }
          ]
        },
        { "name": "link", "description": "Create custom toolchain" }
      ]
    },
    {
      "name": "target",
      "description": "Manage targets",
      "options": [
        {
          "long": "--toolchain",
          "description": "Toolchain to operate on",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
        }
      ],
      "subcommands": [
        { "name": "list", "description": "List available targets" },
        {
          "name": "add",
          "description": "Add a target",
          "arguments": [
            {
              "name": "target",
              "description": "Target triple to add",
              "multiple": true,
              "type": { "type": "Dynamic", "data": { "provider": "rustup.target" } }
            }
          ]
        },
        {
          "name": "remove",
          "description": "Remove a target",
          "arguments": [
            {
              "name": "target",
              "description": "Target triple to remove",
              "multiple": true,
              "type": { "type": "Dynamic", "data": { "provider": "rustup.target" } }
            }
          ]
        }
      ]
    },
    {
      "name": "component",
      "description": "Manage components",
      "options": [
        {
          "long": "--toolchain",
          "description": "Toolchain to operate on",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
        },
        {
          "long": "--target",
          "description": "Target triple the component applies to",
          "takes_value": true,
          "value_type": { "type": "Dynamic", "data": { "provider": "rustup.target" } }
        }
      ],
      "subcommands": [
        { "name": "list", "description": "List components" },
        {
          "name": "add",
          "description": "Add a component",
          "arguments": [
            {
              "name": "component",
              "description": "Component to add",
              "multiple": true,
              "type": { "type": "Dynamic", "data": { "provider": "rustup.component" } }
            }
          ]
        },
        {
          "name": "remove",
          "description": "Remove a component",
          "arguments": [
            {
              "name": "component",
              "description": "Component to remove",
              "multiple": true,
              "type": { "type": "Dynamic", "data": { "provider": "rustup.component" } }
            }
          ]
        }
      ]
    },
    {
      "name": "override",
      "description": "Manage directory overrides",
      "subcommands": [
        { "name": "list", "description": "List overrides" },
        {
          "name": "set",
          "description": "Set override for current directory",
          "arguments": [
            {
              "name": "toolchain",
              "description": "Toolchain to pin",
              "type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
            }
          ]
        },
        { "name": "unset", "description": "Remove override" }
      ]
    },
    {
      "name": "run",
      "description": "Run command with specific toolchain",
      "arguments": [
        {
          "name": "toolchain",
          "description": "Toolchain to run under",
          "type": { "type": "Dynamic", "data": { "provider": "rustup.toolchain" } }
        },
        { "name": "command", "description": "Command to run", "type": { "type": "CommandWithArgs" } }
      ]
    },
    {
      "name": "which",
      "description": "Show which binary runs for a command",
      "arguments": [{ "name": "command", "description": "Command name", "type": { "type": "Command" } }]
    },
    { "name": "doc", "description": "Open documentation" },
    { "name": "self", "description": "Modify rustup itself",
      "subcommands": [
        { "name": "update", "description": "Update rustup" },
        { "name": "uninstall", "description": "Uninstall rustup" }
      ]
    },
    { "name": "check", "description": "Check for updates" }
  ],
  "global_options": [
    { "short": "-v", "long": "--verbose", "description": "Verbose output" },
    { "short": "-q", "long": "--quiet", "description": "Quiet output" },
    { "short": "-h", "long": "--help", "description": "Show help" },
    { "short": "-V", "long": "--version", "description": "Show version" }
  ]
}
