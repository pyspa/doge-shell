{
  "command": "scp",
  "description": "Secure copy (remote file copy program)",
  "global_options": [
    {
      "short": "-r",
      "description": "Recursively copy entire directories"
    },
    {
      "short": "-P",
      "description": "Port to connect to on the remote host",
      "takes_value": true,
      "value_type": {
        "type": "Number"
      }
    },
    {
      "short": "-i",
      "description": "Identity file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-F",
      "description": "SSH configuration file",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "short": "-J",
      "description": "Proxy jump host",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "ssh.host"
        }
      }
    },
    {
      "short": "-p",
      "description": "Preserves modification times, access times, and modes from the original file"
    },
    {
      "short": "-q",
      "description": "Quiet mode"
    },
    {
      "short": "-C",
      "description": "Compression enable"
    },
    {
      "short": "-v",
      "description": "Verbose mode"
    }
  ],
  "arguments": [
    {
      "name": "source",
      "description": "Source file or [user@]host:path",
      "type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "name": "destination",
      "description": "Destination file or [user@]host:path",
      "multiple": true,
      "type": {
        "type": "File",
        "data": {}
      }
    }
  ]
}
