{
  "command": "snap",
  "description": "Snap package manager",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "subcommands": [
    { "name": "install", "description": "Install snap", "arguments": [{ "name": "snap", "multiple": true }] },
    { "name": "remove", "description": "Remove snap", "arguments": [{ "name": "snap", "multiple": true }] },
    { "name": "refresh", "description": "Refresh snaps" },
    { "name": "list", "description": "List installed snaps" },
    { "name": "find", "description": "Find snaps" },
    { "name": "info", "description": "Show snap info" },
    { "name": "services", "description": "List services" },
    { "name": "start", "description": "Start service" },
    { "name": "stop", "description": "Stop service" },
    { "name": "restart", "description": "Restart service" }
  ]
}
