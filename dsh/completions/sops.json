{
  "command": "sops",
  "description": "Secrets editor",
  "global_options": [
    { "short": "-d", "long": "--decrypt", "description": "Decrypt file" },
    { "short": "-e", "long": "--encrypt", "description": "Encrypt file" },
    { "short": "-i", "long": "--in-place", "description": "Edit file in place" },
    { "long": "--input-type", "description": "Input type", "takes_value": true, "value_type": { "type": "Choice", "data": ["json", "yaml", "dotenv", "binary"] } },
    { "long": "--output-type", "description": "Output type", "takes_value": true, "value_type": { "type": "Choice", "data": ["json", "yaml", "dotenv", "binary"] } },
    { "long": "--age", "description": "Age recipients", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [{ "name": "file", "description": "SOPS file", "type": { "type": "File", "data": { "extensions": ["yaml", "yml", "json", "env"] } } }]
}
