{
  "command": "tokei",
  "description": "Count code lines",
  "global_options": [
    { "short": "-f", "long": "--files", "description": "Show individual files" },
    { "short": "-t", "long": "--types", "description": "Language types", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-e", "long": "--exclude", "description": "Exclude paths", "takes_value": true, "value_type": { "type": "String" } },
    { "short": "-o", "long": "--output", "description": "Output format", "takes_value": true, "value_type": { "type": "Choice", "data": ["cbor", "json", "yaml"] } },
    { "long": "--sort", "description": "Sort column", "takes_value": true, "value_type": { "type": "Choice", "data": ["files", "lines", "code", "comments", "blanks"] } },
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [{ "name": "path", "multiple": true, "type": { "type": "File", "data": {} } }]
}
