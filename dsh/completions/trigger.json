{
  "command": "trigger",
  "description": "Run a command when files matching a glob change",
  "global_options": [
    { "short": "-h", "long": "--help", "description": "Show help" }
  ],
  "arguments": [
    { "name": "glob", "description": "Glob pattern", "type": { "type": "String" } },
    { "name": "command", "description": "Command to run", "multiple": true, "type": { "type": "CommandWithArgs" } }
  ]
}
