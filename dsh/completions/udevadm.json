{
  "command": "udevadm",
  "description": "udev management tool",
  "global_options": [
    {
      "description": "Debug output",
      "long": "--debug"
    },
    {
      "description": "Resolve sysname path",
      "short": "-p",
      "long": "--path",
      "takes_value": true,
      "value_type": {
        "type": "File",
        "data": {}
      }
    },
    {
      "description": "Device node",
      "short": "-n",
      "long": "--name",
      "takes_value": true,
      "value_type": {
        "type": "Dynamic",
        "data": {
          "provider": "block.device"
        }
      }
    }
  ],
  "subcommands": [
    {
      "name": "info",
      "description": "Query udev database",
      "arguments": [
        {
          "name": "device",
          "description": "Device path or node",
          "required": false,
          "type": {
            "type": "Dynamic",
            "data": {
              "provider": "block.device"
            }
          }
        }
      ]
    },
    {
      "name": "monitor",
      "description": "Monitor kernel and udev events",
      "options": [
        { "short": "-k", "long": "--kernel", "description": "Print kernel uevents" },
        { "short": "-u", "long": "--udev", "description": "Print udev events" },
        { "short": "-p", "long": "--property", "description": "Print event properties" },
        {
          "short": "-s",
          "long": "--subsystem-match",
          "description": "Filter events by subsystem",
          "takes_value": true,
          "multiple": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "udev.subsystem"
            }
          }
        }
      ]
    },
    {
      "name": "trigger",
      "description": "Request events from the kernel",
      "options": [
        {
          "short": "-c",
          "long": "--action",
          "description": "Event action to trigger",
          "takes_value": true,
          "value_type": { "type": "Choice", "data": ["add", "remove", "change", "move", "online", "offline", "bind", "unbind"] }
        },
        {
          "short": "-s",
          "long": "--subsystem-match",
          "description": "Trigger only devices of this subsystem",
          "takes_value": true,
          "multiple": true,
          "value_type": {
            "type": "Dynamic",
            "data": {
              "provider": "udev.subsystem"
            }
          }
        },
        {
          "short": "-t",
          "long": "--type",
          "description": "Type of events to trigger",
          "takes_value": true,
          "value_type": { "type": "Choice", "data": ["devices", "subsystems", "all"] }
        },
        { "short": "-v", "long": "--verbose", "description": "Print triggered devices" },
        { "short": "-n", "long": "--dry-run", "description": "Do not actually trigger events" }
      ]
    },
    {
      "name": "settle",
      "description": "Wait for udev event queue"
    },
    {
      "name": "control",
      "description": "Control the udev daemon"
    },
    {
      "name": "test",
      "description": "Test an event run",
      "arguments": [
        {
          "name": "device",
          "description": "Device path",
          "type": {
            "type": "File",
            "data": {}
          }
        }
      ]
    }
  ]
}
