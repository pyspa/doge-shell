sp              = _{ " " | "\t" | "\r" }
word_char       = _{
    !("|" | "&" | ";" | " " | "\t" | "\r" | "\n" | "`" | "{" | "}" | "<" | ">" | "(" | ")" | "$" | "\"" | "'" | "*" | "?" | "[" | "\\") ~ ANY
}
escape_sequence =  { "\\" ~ ANY }

word                =  { (escape_sequence | word_char)+ }

var_name_char       = _{ ASCII_ALPHANUMERIC | "_" }
var_name            =  { var_name_char+ }
// Only the specials the shell can actually answer. Adding a name here without
// a resolver would turn `$x` into the literal string `$x`, which is a silently
// wrong value rather than an error.
// Unbraced positions consume exactly one digit: $10 is $1 followed by 0.
invocation_special = _{ "#" | "@" | "*" }
invocation_parameter = { "${" ~ (ASCII_DIGIT+ | invocation_special) ~ "}" | "$" ~ (ASCII_DIGIT | invocation_special) }
special_var         =  { "?" | "$" | "!" }
variable_braced     =  { "${" ~ var_name ~ "}" }
variable_special    =  { "$" ~ special_var }
variable_named      =  { "$" ~ var_name }
variable_indexed    =  { "$" ~ var_name ~ "[" ~ ASCII_DIGIT+ ~ "]" }
variable            =  { variable_braced | variable_indexed | variable_special | variable_named }

// Structured POSIX parameter expansion for named shell variables only
// (`${VAR:-word}` and the seven sibling forms). Simple `${VAR}` stays
// `variable_braced`; anything else (`${#X}`, `${X%foo}`, ...) matches
// neither and fails strict parsing instead of running truncated.
parameter_name     =  { (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
parameter_operator =  { ":-" | ":=" | ":?" | ":+" | "-" | "=" | "?" | "+" }
parameter_expansion = { "${" ~ parameter_name ~ parameter_operator ~ parameter_word? ~ "}" }
// Operand text: any run that starts none of `$ " ' \` `}`. Spaces, `* ? [`,
// `{`, `| & ; < > ( )` and newlines stay literal content here (they are only
// separators at the top-level command layer). `\` starts an `escape_sequence`
// and `$` starts a nested expansion/variable/substitution, so both terminate
// the run and become their own part, preserving escape provenance.
parameter_text      = ${ ( !("$" | "\"" | "'" | "\\" | "}") ~ ANY )+ }
parameter_word      =  { parameter_word_part+ }
parameter_word_part = _{
      arithmetic_expansion
    | parameter_expansion
    | quoted
    | command_subst
    | proc_subst
    | subshell
    | invocation_parameter
    | variable
    | escape_sequence
    | parameter_text
}
glob_char           = _{ "*" | "?" | "[" }
glob_remaining_char = _{ word_char | glob_char | "]" | "{" | "}" | escape_sequence }
glob_word           =  { (word_char | escape_sequence)* ~ glob_char ~ glob_remaining_char* }

brace_word = { (word_char | escape_sequence | glob_char)* ~ "{" ~ glob_remaining_char* }

s_quoted         =  { "\'" ~ s_quoted_inner* ~ "\'" }
s_quoted_inner   = _{
    literal_s_quoted
}
literal_s_quoted = ${ ("\\'" | !("\'") ~ ANY | sp)+ }

d_quoted         =  { "\"" ~ d_quoted_inner* ~ "\"" }
// `arithmetic_expansion` first so `$((...))` is not read as a `$(` prefix.
// `parameter_expansion` before `variable` so `"${A:-x}"` is not read as a
// truncated `${A}` prefix.
d_quoted_inner   = _{ arithmetic_expansion | command_subst | parameter_expansion | invocation_parameter
    | variable | literal_d_quoted }
// A `$` that starts no variable stays literal, so `"price is $"` keeps working.
// Backtick is literal here: the grammar has no backtick-substitution rule, and
// excluding it made the whole line truncate instead.
literal_d_quoted = ${
    ( "\\" ~ ANY
    | "$" ~ !("{" | "(" | var_name_char | special_var | invocation_special)
    | !("\"" | "\\" | "$") ~ ANY
    )+
}

proc_subst_direction_in  = { "<(" }
proc_subst_direction_out = { ">(" }

proc_subst_direction = {
    proc_subst_direction_in
  | proc_subst_direction_out
}
proc_subst              =  { proc_subst_direction ~ group_list ~ ")" }
command_subst           =  { "$(" ~ sp* ~ group_list ~ sp* ~ ")" }
subshell                =  { "(" ~ group_list ~ ")" }
// POSIX `$((expression))`: tried before `$(` so `$((` is never read as a
// command-substitution prefix. The body stays structured (variables,
// `${...}`, `$(...)`, nested `$((...))`, parenthesized groups, quoted
// strings) for runtime scalar expansion; plain arithmetic characters are
// `arithmetic_text`. A lone `$` that starts no expansion stays literal so
// arithmetic like `$ + 1` does not break the whole expansion.
arithmetic_expansion = { "$((" ~ arithmetic_inner* ~ "))" }
arithmetic_inner   = _{
      arithmetic_expansion
    | parameter_expansion
    | command_subst
    | invocation_parameter
    | variable
    | quoted
    | arithmetic_paren
    | escape_sequence
    | arithmetic_text
}
arithmetic_paren     = { "(" ~ arithmetic_inner* ~ ")" }
arithmetic_text      = @{ (
      "$" ~ !("(" | "{" | ASCII_ALPHANUMERIC | "_" | "?" | "$" | "!" | invocation_special)
    | !("$" | "\"" | "'" | "\\" | "(" | ")") ~ ANY
)+ }
group_list              = _{
    commands
}

quoted = _{ d_quoted | s_quoted }

stdin_redirect_direction_in         = { "<" ~ !"(" }
stdouterr_redirect_direction_out    = { "&>" }
stdouterr_redirect_direction_append = { "&>>" }
stderr_redirect_direction_out       = { "2>" }
stderr_redirect_direction_append    = { "2>>" }
stdout_redirect_direction_out       = { ">" ~ !"(" }
stdout_redirect_direction_append    = { ">>" }
stdouterr_redirect_direction        = { (stdouterr_redirect_direction_append | stdouterr_redirect_direction_out) }
stderr_redirect_direction           = { (stderr_redirect_direction_append | stderr_redirect_direction_out) }
stdout_redirect_direction           = { (stdout_redirect_direction_append | stdout_redirect_direction_out) }
stdin_redirect_direction            = { stdin_redirect_direction_in }

// File-descriptor duplication. This has to be tried before the plain
// redirects: `2>&1` otherwise matches `2>` and then fails on `&`, the whole
// redirect fails, and `2` is left to be read as an ordinary argument -- which
// is how `ls x 2>&1` ended up running `ls x 2`.
fd_number                           = { ASCII_DIGIT+ }
fd_dup_target                       = { fd_number | "-" }
fd_dup_out                          = { fd_number? ~ ">&" ~ fd_dup_target }
fd_dup_in                           = { fd_number? ~ "<&" ~ fd_dup_target }
fd_dup                              = { fd_dup_out | fd_dup_in }
redirect                            = { fd_dup | (stdouterr_redirect_direction | stderr_redirect_direction | stdout_redirect_direction | stdin_redirect_direction) ~ sp* ~ span }
word_part                           = _{ arithmetic_expansion | parameter_expansion | quoted | command_subst | proc_subst | subshell | invocation_parameter
    | variable | glob_word | brace_word | word }
span                                = { word_part+ }
argv0                               = { span }
args                                = { (sp* ~ redirect | sp+ ~ span)+ }

background_op  = { !("&&") ~ "&" }
capture_op     = { "|>" }
struct_pipe_op = { "|:" }
pipeline_op    = { !("|>" | "|:") ~ "|" }
sequential_op  = { ";" }
and_op         = { "&&" }
or_op          = { "||" }

and_or_op         =  { and_op | or_op }
list_separator    =  { sequential_op | background_op }
// A name=value prefix. Every branch below requires content, so
// `simple_command` can never match empty -- it sits inside a `*` in
// `command`, where an empty match would spin.
assign_name         =  { (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
assignment          =  { assign_name ~ "=" ~ span? }
// Prefix assignments and redirects in any order, with an optional command
// word after them. This covers `> file`, `FOO=bar > file`, and command-prefix
// redirects such as `> file /bin/echo hello`, while plain `cmd args` still
// takes the second branch.
simple_command      =  { sp* ~ ((assignment | redirect) ~ (sp+ ~ (assignment | redirect))* ~ (sp+ ~ argv0 ~ args*)? | argv0 ~ args*) }
pipe_command        =  { pipeline_op ~ sp* ~ simple_command ~ sp* }
struct_pipe_command =  { struct_pipe_op ~ sp* ~ (lisp_expr | struct_pipe_dsl) ~ sp* }
lisp_expr           =  { "(" ~ lisp_inner* ~ ")" }
lisp_inner          = _{ !(")" | "(") ~ ANY | lisp_expr }
// The `|:` structured-pipe DSL (`where cpu > 5 | select pid`), tried only
// after `lisp_expr` fails. Runs to the end of the statement so it can use a
// bare `|` as its own stage separator; quoted spans are skipped whole so a
// `;` or `|` inside a value doesn't end the DSL early. Desugared to Lisp in
// `dsh/src/shell/struct_pipe.rs`, not interpreted by the grammar itself.
struct_pipe_dsl_quoted = _{ ("\"" ~ (!"\"" ~ ANY)* ~ "\"") | ("\'" ~ (!"\'" ~ ANY)* ~ "\'") }
struct_pipe_dsl        = @{
    (struct_pipe_dsl_quoted | (!(NEWLINE | ";" | "&" | "||" | "|>" | "|:") ~ ANY))+
}
capture_suffix      =  { sp* ~ capture_op }
// `&` is not a simple-command suffix: it separates whole AND-OR lists
// (`a && b || c & d` backgrounds `a && b || c`, then runs `d`). A `command`
// always starts from a `simple_command`, so an empty line parses as no
// `and_or_list` at all and separators can never match an empty list —
// `& echo`, `a & & b`, `a && & b` and `a &; b` all leave an unparsed tail
// that strict execution rejects.
command             =  { sp* ~ simple_command ~ sp* ~ (struct_pipe_command | pipe_command)* ~ capture_suffix? }
and_or_list         =  { command ~ (sp* ~ and_or_op ~ sp* ~ command)* }
commands            =  { sp* ~ and_or_list ~ (sp* ~ list_separator ~ sp* ~ and_or_list)* ~ (sp* ~ list_separator)? }
